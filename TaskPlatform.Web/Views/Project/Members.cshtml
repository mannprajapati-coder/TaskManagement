@model List<TaskPlatform.Shared.ViewModels.Project.ProjectMemberViewModel>
@{
    var project = ViewBag.Project as TaskPlatform.Shared.ViewModels.Project.ProjectViewModel;
    var joinRequests = ViewBag.JoinRequests as List<TaskPlatform.Shared.ViewModels.Project.ProjectJoinRequestViewModel> ?? new List<TaskPlatform.Shared.ViewModels.Project.ProjectJoinRequestViewModel>();
    ViewData["Title"] = $"{project?.Name ?? "Project"} Members";
}

<div class="py-2">
    <!-- Header Banner -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-3 border-bottom">
        <div>
            <h3 class="fw-extrabold text-dark mb-1">
                <i class="bi bi-people-fill text-primary me-2"></i>Project Team Roster
            </h3>
            <p class="text-secondary small mb-0">Manage project team roles and pending join requests for <strong>@project?.Name</strong>.</p>
        </div>

        <a asp-action="Detail" asp-route-id="@project?.Id" class="btn btn-outline-custom btn-sm px-3">
            <i class="bi bi-arrow-left me-1"></i> Back to Project
        </a>
    </div>

    <!-- Pending Join Requests Banner -->
    @if (joinRequests.Any())
    {
        <div class="card border-0 shadow-sm rounded-4 mb-4 border-start border-4 border-warning bg-white">
            <div class="card-body p-4">
                <h5 class="fw-bold text-dark mb-3"><i class="bi bi-person-exclamation text-warning me-2"></i> Pending Join Requests</h5>
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead class="bg-light">
                            <tr class="text-muted small fw-bold">
                                <th class="ps-3 py-2">APPLICANT</th>
                                <th class="py-2">REQUESTED DATE</th>
                                <th class="pe-3 text-end py-2">ACTION</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var req in joinRequests)
                            {
                                <tr>
                                    <td class="ps-3 py-3">
                                        <div class="fw-bold text-dark">@req.RequestingUserName</div>
                                        <div class="extra-small text-muted">@req.RequestingUserEmail</div>
                                    </td>
                                    <td class="small text-muted">@req.CreatedAt.ToString("MMM dd, yyyy")</td>
                                    <td class="pe-3 text-end">
                                        <form asp-action="ResolveJoinRequest" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="RequestId" value="@req.RequestId" />
                                            <input type="hidden" name="projectId" value="@project?.Id" />
                                            <button type="submit" name="Approve" value="true" class="btn btn-sm btn-gradient px-3">Approve</button>
                                            <button type="submit" name="Approve" value="false" class="btn btn-sm btn-outline-danger px-3">Reject</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    <!-- Team Members Roster -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
        <div class="card-body p-0">
            <div class="px-4 py-3 bg-light border-bottom">
                <h5 class="fw-bold text-dark mb-0">Active Team Members (@Model.Count)</h5>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light border-bottom">
                        <tr class="text-secondary small fw-bold">
                            <th class="ps-4 py-3">MEMBER NAME</th>
                            <th class="py-3">ROLE</th>
                            <th class="pe-4 text-end py-3">JOINED DATE</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y">
                        @foreach (var member in Model)
                        {
                            <tr>
                                <td class="ps-4 py-3">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="avatar avatar-sm font-bold">
                                            @(string.IsNullOrEmpty(member.FullName) ? "U" : member.FullName.Substring(0, 1).ToUpper())
                                        </div>
                                        <div>
                                            <div class="fw-bold text-dark">@member.FullName</div>
                                            <div class="extra-small text-muted">@member.Email</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-1 fw-semibold">
                                        @member.Role
                                    </span>
                                </td>
                                <td class="pe-4 text-end small text-muted">
                                    @member.JoinedAt.ToString("MMM dd, yyyy")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
