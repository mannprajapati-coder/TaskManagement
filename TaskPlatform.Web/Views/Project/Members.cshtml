@model List<TaskPlatform.Shared.ViewModels.Project.ProjectMemberViewModel>
@{
    var project = ViewBag.Project as TaskPlatform.Shared.ViewModels.Project.ProjectViewModel;
    var joinRequests = ViewBag.JoinRequests as List<TaskPlatform.Shared.ViewModels.Project.ProjectJoinRequestViewModel> ?? new List<TaskPlatform.Shared.ViewModels.Project.ProjectJoinRequestViewModel>();
    ViewData["Title"] = $"{project?.Name ?? "Project"} Members";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-1">Project Members</h3>
            <p class="text-muted small mb-0">Team membership and role permissions for <strong>@project?.Name</strong></p>
        </div>
        <a asp-action="Detail" asp-route-id="@project?.Id" class="btn btn-outline-secondary rounded-pill px-3"><i class="bi bi-arrow-left"></i> Back to Project</a>
    </div>

    @if (joinRequests.Any())
    {
        <div class="card border-0 shadow-sm rounded-4 mb-4 border-start border-4 border-warning">
            <div class="card-body p-4">
                <h5 class="fw-bold text-dark mb-3"><i class="bi bi-person-exclamation text-warning me-2"></i> Pending Join Requests</h5>
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead>
                            <tr class="text-muted small">
                                <th>Applicant</th>
                                <th>Requested Date</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var req in joinRequests)
                            {
                                <tr>
                                    <td>
                                        <span class="fw-semibold">@req.RequestingUserName</span>
                                        <span class="text-muted small d-block">@req.RequestingUserEmail</span>
                                    </td>
                                    <td class="small text-muted">@req.CreatedAt.ToString("MMM dd, yyyy")</td>
                                    <td class="text-end">
                                        <form asp-action="ResolveJoinRequest" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="RequestId" value="@req.RequestId" />
                                            <input type="hidden" name="projectId" value="@project?.Id" />
                                            <button type="submit" name="Approve" value="true" class="btn btn-sm btn-success rounded-pill px-3">Approve (Developer)</button>
                                            <button type="submit" name="Approve" value="false" class="btn btn-sm btn-outline-danger rounded-pill px-3">Reject</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">
            <h5 class="fw-bold text-dark mb-3">Team Members</h5>
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr class="text-muted small">
                            <th>Member</th>
                            <th>Role</th>
                            <th>Joined Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var member in Model)
                        {
                            <tr>
                                <td>
                                    <span class="fw-semibold">@member.FullName</span>
                                    <span class="text-muted small d-block">@member.Email</span>
                                </td>
                                <td><span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill">@member.Role</span></td>
                                <td class="small text-muted">@member.JoinedAt.ToString("MMM dd, yyyy")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
