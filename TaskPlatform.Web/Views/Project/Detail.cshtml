@model TaskPlatform.Shared.ViewModels.Project.ProjectViewModel
@{
    ViewData["Title"] = Model.Name;
}

<div class="py-2">
    <!-- Project Header Card -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 bg-white">
        <div class="card-body p-4 p-md-5">
            <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-3">
                <div>
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <h2 class="fw-extrabold text-dark mb-0">@Model.Name</h2>
                        <span class="badge-status badge-inprogress">@Model.Status</span>
                    </div>
                    <p class="text-secondary small mb-0">@(string.IsNullOrEmpty(Model.Description) ? "No detailed project description." : Model.Description)</p>
                </div>
                <div class="d-flex gap-2 flex-wrap">
                    <a asp-action="Members" asp-route-id="@Model.Id" class="btn btn-outline-custom btn-sm px-3">
                        <i class="bi bi-people me-1"></i> Team Members
                    </a>
                    <a asp-controller="Task" asp-action="Create" asp-route-projectId="@Model.Id" class="btn btn-gradient btn-sm px-3 shadow-sm">
                        <i class="bi bi-plus-lg me-1"></i> Create Task
                    </a>
                    <a asp-controller="Task" asp-action="Index" asp-route-projectId="@Model.Id" class="btn btn-gradient btn-sm px-3 shadow-sm">
                        Task Board <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>

            <hr class="my-4 text-muted opacity-25" />

            <!-- Metrics Row -->
            <div class="row text-center g-3">
                <div class="col-6 col-md-3">
                    <div class="p-3 bg-light rounded-3">
                        <span class="extra-small text-muted d-block font-semibold">Start Date</span>
                        <strong class="text-dark fs-6">@(Model.StartDate?.ToString("MMM dd, yyyy") ?? "Not Set")</strong>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="p-3 bg-light rounded-3">
                        <span class="extra-small text-muted d-block font-semibold">End Date</span>
                        <strong class="text-dark fs-6">@(Model.EndDate?.ToString("MMM dd, yyyy") ?? "Not Set")</strong>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="p-3 bg-light rounded-3">
                        <span class="extra-small text-muted d-block font-semibold">Client</span>
                        <strong class="text-dark fs-6">@(Model.Client ?? "Internal Project")</strong>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="p-3 bg-light rounded-3">
                        <span class="extra-small text-muted d-block font-semibold">Budget</span>
                        <strong class="text-dark fs-6">@(Model.Budget.HasValue ? $"${Model.Budget:N2}" : "Unspecified")</strong>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Interactive Task Board Launcher Card -->
    <div class="card border-0 shadow-sm rounded-4 text-center py-5 bg-white card-hover">
        <div class="card-body py-4">
            <div class="avatar bg-primary-subtle text-primary mx-auto mb-3" style="width: 64px; height: 64px; font-size: 2rem;">
                <i class="bi bi-kanban"></i>
            </div>
            <h4 class="fw-bold text-dark mb-2">Interactive Task Board</h4>
            <p class="text-secondary small mb-4">Manage tasks across Todo, In Progress, In Review, Completed and Cancelled columns.</p>
            <a asp-controller="Task" asp-action="Index" asp-route-projectId="@Model.Id" class="btn btn-gradient px-4 py-2 font-semibold shadow-sm">
                Open Kanban Task Board <i class="bi bi-arrow-right ms-1"></i>
            </a>
        </div>
    </div>
</div>
