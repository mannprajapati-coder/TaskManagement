@model TaskPlatform.Shared.ViewModels.Workspace.WorkspaceViewModel
@{
    ViewData["Title"] = "Workspace Settings";
}

<div class="py-2">
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white max-w-4xl mx-auto mb-4" style="max-width: 900px;">
        <div class="p-4 p-md-5 bg-gradient text-white" style="background: linear-gradient(135deg, #4f46e5 0%, #3b82f6 100%);">
            <div class="d-flex align-items-center gap-3">
                <div class="avatar bg-white text-primary fw-extrabold shadow-sm" style="width: 54px; height: 54px; font-size: 1.5rem;">
                    <i class="bi bi-gear-fill"></i>
                </div>
                <div>
                    <h3 class="fw-extrabold text-white mb-1">Workspace Settings</h3>
                    <p class="text-white text-opacity-90 small mb-0">Manage workspace details, team invite links, and archiving for <strong>@Model.Name</strong>.</p>
                </div>
            </div>
        </div>

        <div class="card-body p-4 p-md-5">
            <div class="row g-5">
                <!-- Left: Edit Workspace Details -->
                <div class="col-lg-6 border-end-lg">
                    <h5 class="fw-bold text-dark mb-3"><i class="bi bi-pencil-square text-primary me-2"></i>Workspace Profile</h5>
                    <form asp-action="UpdateSettings" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="WorkspaceId" value="@Model.Id" />

                        <div class="mb-3">
                            <label class="form-label small fw-bold text-dark">Workspace Name</label>
                            <input name="Name" value="@Model.Name" class="form-control" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-bold text-dark">Description</label>
                            <textarea name="Description" class="form-control" rows="3">@Model.Description</textarea>
                        </div>
                        <button type="submit" class="btn btn-gradient px-4 py-2 font-semibold shadow-sm">Save Changes</button>
                    </form>
                </div>

                <!-- Right: Invite Links -->
                <div class="col-lg-6">
                    <h5 class="fw-bold text-dark mb-3"><i class="bi bi-person-plus-fill text-primary me-2"></i>Invite Teammates</h5>
                    <p class="text-secondary small mb-3">Generate an invite link to share with new workspace members.</p>
                    
                    <form asp-action="InviteMembers" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="WorkspaceId" value="@Model.Id" />
                        <div class="row g-2 mb-3">
                            <div class="col-6">
                                <label class="form-label small fw-bold text-dark">Expiry (Days)</label>
                                <input type="number" name="ExpiryDays" value="7" class="form-control" min="1" max="30" />
                            </div>
                            <div class="col-6">
                                <label class="form-label small fw-bold text-dark">Max Uses</label>
                                <input type="number" name="MaxUses" value="10" class="form-control" min="1" max="100" />
                            </div>
                        </div>
                        <button type="submit" class="btn btn-outline-custom w-100 py-2 font-semibold"><i class="bi bi-link-45deg me-1"></i> Generate Invite Link</button>
                    </form>

                    @if (TempData["InviteUrl"] != null)
                    {
                        <div class="mt-3 p-3 bg-light rounded-3 border">
                            <label class="form-label extra-small text-muted fw-bold mb-1">Generated Invite Token Link:</label>
                            <div class="input-group">
                                <input type="text" value="@TempData["InviteUrl"]" class="form-control form-control-sm bg-white" readonly />
                                <button type="button" class="btn btn-sm btn-gradient px-3" onclick="navigator.clipboard.writeText('@TempData["InviteUrl"]')">Copy</button>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <hr class="my-4 text-muted opacity-25" />

            <!-- Archive Danger Zone -->
            <div class="p-3 bg-danger-subtle bg-opacity-20 border border-danger-subtle rounded-3 d-flex justify-content-between align-items-center flex-wrap gap-3">
                <div>
                    <h6 class="fw-bold text-danger mb-0"><i class="bi bi-exclamation-triangle me-1"></i> Archive Workspace</h6>
                    <p class="extra-small text-secondary mb-0">Hides this workspace from default navigation while preserving project history.</p>
                </div>
                <form asp-action="Archive" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" onclick="return confirm('Archive this workspace?')" class="btn btn-outline-danger btn-sm px-3 font-semibold">
                        Archive Workspace
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
