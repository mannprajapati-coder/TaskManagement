@model TaskPlatform.Shared.ViewModels.Workspace.WorkspaceViewModel
@{
    ViewData["Title"] = "Workspace Settings";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-4">
                    <h4 class="fw-bold mb-3">Workspace Settings</h4>
                    <form asp-action="UpdateSettings" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="WorkspaceId" value="@Model.Id" />

                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Workspace Name</label>
                            <input name="Name" value="@Model.Name" class="form-control" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Description</label>
                            <textarea name="Description" class="form-control" rows="3">@Model.Description</textarea>
                        </div>
                        <button type="submit" class="btn btn-gradient px-4">Save Changes</button>
                    </form>
                </div>
            </div>

            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-4">
                    <h5 class="fw-semibold mb-2">Invite Members</h5>
                    <p class="text-muted small mb-3">Generate an invite link to share with your teammates</p>
                    
                    <form asp-action="InviteMembers" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="WorkspaceId" value="@Model.Id" />
                        <div class="row g-2 mb-3">
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Expiry (Days)</label>
                                <input type="number" name="ExpiryDays" value="7" class="form-control" min="1" max="30" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Max Uses</label>
                                <input type="number" name="MaxUses" value="10" class="form-control" min="1" max="100" />
                            </div>
                        </div>
                        <button type="submit" class="btn btn-outline-primary px-4"><i class="bi bi-link-45deg"></i> Generate Invite Link</button>
                    </form>

                    @if (TempData["InviteUrl"] != null)
                    {
                        <div class="mt-3 p-3 bg-light rounded-3 border">
                            <label class="form-label extra-small text-muted fw-semibold mb-1">Generated Invite Link:</label>
                            <div class="input-group">
                                <input type="text" value="@TempData["InviteUrl"]" class="form-control form-control-sm bg-white" readonly />
                                <button type="button" class="btn btn-sm btn-outline-secondary" onclick="navigator.clipboard.writeText('@TempData["InviteUrl"]')">Copy</button>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="card border-0 shadow-sm rounded-4 border-danger border-opacity-25">
                <div class="card-body p-4">
                    <h5 class="fw-semibold text-danger mb-2">Danger Zone</h5>
                    <p class="text-muted small mb-3">Archive this workspace. It will be hidden from default navigation but projects will be preserved.</p>
                    <form asp-action="Archive" asp-route-id="@Model.Id" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" onclick="return confirm('Archive this workspace?')" class="btn btn-outline-danger px-4">Archive Workspace</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
