@model TaskPlatform.Shared.ViewModels.Workspace.WorkspaceViewModel
@using TaskPlatform.Shared.ViewModels.Project
@{
    ViewData["Title"] = Model.Name;
    var projects = ViewBag.Projects as List<ProjectViewModel> ?? new List<ProjectViewModel>();
}

<div class="py-2">
    <!-- Workspace Header Card -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 bg-white">
        <div class="card-body p-4 p-md-5">
            <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-3">
                <div>
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <h2 class="fw-extrabold text-dark mb-0">@Model.Name</h2>
                        <span class="badge bg-primary-subtle text-primary border rounded-pill px-3">Workspace</span>
                    </div>
                    <p class="text-secondary small mb-0">@(string.IsNullOrEmpty(Model.Description) ? "Developer workspace environment" : Model.Description)</p>
                </div>
                <div class="d-flex gap-2">
                    <a asp-action="Settings" asp-route-id="@Model.Id" class="btn btn-outline-custom btn-sm px-3">
                        <i class="bi bi-gear me-1"></i> Settings
                    </a>
                    <a asp-controller="Project" asp-action="Create" asp-route-workspaceId="@Model.Id" class="btn btn-gradient btn-sm px-3 shadow-sm">
                        <i class="bi bi-plus-lg me-1"></i> New Project
                    </a>
                </div>
            </div>
            <hr class="my-3 text-muted opacity-25" />
            <div class="d-flex gap-4 text-muted small">
                <span><i class="bi bi-people-fill text-primary me-1"></i> @Model.MemberCount Member(s)</span>
                <span><i class="bi bi-folder-fill text-primary me-1"></i> @projects.Count Project(s)</span>
                <span><i class="bi bi-calendar-event me-1"></i> Created @Model.CreatedAt.ToString("MMM dd, yyyy")</span>
            </div>
        </div>
    </div>

    <!-- Projects List Header -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="fw-bold text-dark mb-0"><i class="bi bi-folder2-open text-primary me-2"></i>Workspace Projects</h4>
        @if (projects.Any())
        {
            <a asp-controller="Project" asp-action="Create" asp-route-workspaceId="@Model.Id" class="small text-primary text-decoration-none fw-bold">
                + Add Another Project
            </a>
        }
    </div>

    @if (!projects.Any())
    {
        <div class="card border-0 shadow-sm rounded-4 text-center py-5 bg-white">
            <div class="card-body py-4">
                <div class="avatar bg-primary-subtle text-primary mx-auto mb-3" style="width: 64px; height: 64px; font-size: 2rem;">
                    <i class="bi bi-folder-plus"></i>
                </div>
                <h5 class="fw-bold text-dark mb-1">No Projects in this Workspace</h5>
                <p class="text-secondary small mb-4">Create your first project to start organizing tasks, timelines, and deliverables.</p>
                <a asp-controller="Project" asp-action="Create" asp-route-workspaceId="@Model.Id" class="btn btn-gradient px-4 py-2 shadow-sm font-semibold">
                    <i class="bi bi-plus-circle me-1"></i> Create First Project
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var proj in projects)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 border-0 shadow-sm rounded-4 card-hover transition bg-white">
                        <div class="card-body p-4 d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h5 class="fw-bold text-dark mb-0">
                                    <a asp-controller="Project" asp-action="Detail" asp-route-id="@proj.Id" class="text-dark text-decoration-none hover-primary">@proj.Name</a>
                                </h5>
                                <form asp-controller="Project" asp-action="ToggleFavorite" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@proj.Id" />
                                    <input type="hidden" name="workspaceId" value="@Model.Id" />
                                    <button type="submit" class="btn btn-sm p-0 border-0 text-warning" title="Toggle Favorite">
                                        <i class="bi @(proj.IsFavorite ? "bi-star-fill" : "bi-star")"></i>
                                    </button>
                                </form>
                            </div>
                            
                            <p class="text-secondary small flex-grow-1 mb-3">
                                @(string.IsNullOrEmpty(proj.Description) ? "No project description provided." : proj.Description)
                            </p>
                            
                            <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                                <span class="badge-status badge-inprogress">@proj.Status</span>
                                <div class="d-flex gap-2">
                                    <a asp-controller="Project" asp-action="Detail" asp-route-id="@proj.Id" class="btn btn-sm btn-outline-custom px-3">
                                        Open <i class="bi bi-arrow-right ms-1"></i>
                                    </a>
                                    <a asp-controller="Task" asp-action="Index" asp-route-projectId="@proj.Id" class="btn btn-sm btn-gradient px-3">
                                        Board
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
