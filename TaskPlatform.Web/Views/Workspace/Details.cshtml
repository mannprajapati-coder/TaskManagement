@model TaskPlatform.Shared.ViewModels.Workspace.WorkspaceViewModel
@{
    ViewData["Title"] = Model.Name;
}

<div class="container py-4">
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h3 class="fw-bold text-dark mb-1">@Model.Name</h3>
                    <p class="text-muted small mb-0">@Model.Description</p>
                </div>
                <div class="d-flex gap-2">
                    <a asp-action="Settings" asp-route-id="@Model.Id" class="btn btn-outline-secondary rounded-pill px-3"><i class="bi bi-gear"></i> Settings</a>
                    <a asp-controller="Project" asp-action="Create" asp-route-workspaceId="@Model.Id" class="btn btn-gradient rounded-pill px-3"><i class="bi bi-plus-lg"></i> New Project</a>
                </div>
            </div>
            <hr class="my-3 text-muted opacity-25" />
            <div class="d-flex gap-4 text-muted small">
                <span><i class="bi bi-people me-1"></i> @Model.MemberCount Members</span>
                <span><i class="bi bi-calendar-event me-1"></i> Created @Model.CreatedAt.ToString("MMM dd, yyyy")</span>
            </div>
        </div>
    </div>

    <!-- Projects Placeholder (Coming in Sprint 03) -->
    <div class="card border-0 shadow-sm rounded-4 text-center py-5">
        <div class="card-body">
            <i class="bi bi-folder-symlink text-primary display-4 mb-3"></i>
            <h5 class="fw-bold">Projects in this Workspace</h5>
            <p class="text-muted small">Project Management functionality will wire in Sprint 03!</p>
        </div>
    </div>
</div>
