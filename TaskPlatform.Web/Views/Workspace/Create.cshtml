@model TaskPlatform.Shared.ViewModels.Workspace.CreateWorkspaceRequestViewModel
@{
    ViewData["Title"] = "Create Workspace";
}

<div class="auth-wrapper">
    <div class="auth-card">
        <div class="text-center mb-4">
            <h3 class="fw-bold text-dark mb-1">Create Workspace</h3>
            <p class="text-muted small">Set up a new workspace for your projects and team</p>
        </div>

        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

            <div class="mb-3">
                <label asp-for="Name" class="form-label small fw-semibold">Workspace Name</label>
                <input asp-for="Name" class="form-control" placeholder="e.g. Acme Engineering" />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Description" class="form-label small fw-semibold">Description</label>
                <textarea asp-for="Description" class="form-control" rows="3" placeholder="Brief workspace description..."></textarea>
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>

            <div class="d-flex gap-2">
                <a asp-action="Index" class="btn btn-outline-secondary w-50">Cancel</a>
                <button type="submit" class="btn btn-gradient w-50">Create <i class="bi bi-check-lg"></i></button>
            </div>
        </form>
    </div>
</div>
