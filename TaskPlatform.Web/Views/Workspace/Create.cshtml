@model TaskPlatform.Shared.ViewModels.Workspace.CreateWorkspaceRequestViewModel
@{
    ViewData["Title"] = "Create Workspace";
}

<div class="py-2 py-md-3">
    <div class="card border-0 shadow-lg rounded-4 overflow-hidden bg-white mx-auto" style="max-width: 580px;">
        <!-- Brand Header -->
        <div class="p-3 p-md-4 text-white" style="background: var(--primary-gradient);">
            <div class="d-flex align-items-center gap-3">
                <div class="avatar bg-white text-primary fw-extrabold shadow-xs" style="width: 44px; height: 44px; font-size: 1.25rem;">
                    <i class="bi bi-diagram-3-fill"></i>
                </div>
                <div>
                    <h4 class="fw-extrabold text-white mb-0">Create Workspace</h4>
                    <p class="text-white text-opacity-90 extra-small mb-0">Set up a dedicated workspace for your team projects.</p>
                </div>
            </div>
        </div>

        <!-- Form Body -->
        <div class="card-body p-3 p-md-4">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger small p-2 rounded-3 mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label small fw-bold text-dark">Workspace Name</label>
                    <input asp-for="Name" class="form-control" placeholder="e.g. Acme Engineering" required />
                    <span asp-validation-for="Name" class="text-danger extra-small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Description" class="form-label small fw-bold text-dark">Description</label>
                    <textarea asp-for="Description" class="form-control" rows="3" placeholder="Brief summary of projects in this workspace..."></textarea>
                    <span asp-validation-for="Description" class="text-danger extra-small"></span>
                </div>

                <div class="d-flex gap-2">
                    <a asp-action="Index" class="btn btn-outline-custom w-50 py-2">Cancel</a>
                    <button type="submit" class="btn btn-gradient w-50 py-2 shadow-sm font-semibold">
                        Create Workspace <i class="bi bi-check-lg ms-1"></i>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
