@model TaskPlatform.Web.ViewComponents.WorkspaceSwitcherViewModel
@{
    var current = Model.Workspaces.FirstOrDefault(w => w.Id == Model.CurrentWorkspaceId);
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
}

<div class="dropdown" id="workspaceSwitcher">
    <button class="btn btn-light rounded-pill px-3 py-1 border d-flex align-items-center gap-2 shadow-xs" type="button" id="workspaceSwitcherBtn" data-bs-toggle="dropdown" aria-expanded="false" title="Current Workspace">
        <i class="bi bi-building text-primary"></i>
        <span class="fw-bold small text-dark d-none d-md-inline text-truncate" style="max-width: 160px;">@(current?.Name ?? "No Workspace")</span>
        <i class="bi bi-chevron-down small text-muted"></i>
    </button>
    <div class="dropdown-menu shadow-xl border-0 rounded-4 p-2 mt-2" style="width: 280px;" aria-labelledby="workspaceSwitcherBtn">
        <div class="small text-muted fw-bold text-uppercase tracking-wider px-2 mb-1">Switch Workspace</div>
        @if (Model.Workspaces.Any())
        {
            @foreach (var ws in Model.Workspaces)
            {
                var isCurrent = ws.Id == Model.CurrentWorkspaceId;
                <form asp-controller="Workspace" asp-action="SetCurrent" asp-route-returnUrl="@returnUrl" method="post" class="mb-1">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="workspaceId" value="@ws.Id" />
                    <button type="submit" class="dropdown-item rounded-3 d-flex align-items-center justify-content-between px-2 py-2 @(isCurrent ? "bg-primary-subtle" : "")">
                        <span class="text-truncate fw-semibold text-dark">@ws.Name</span>
                        @if (isCurrent)
                        {
                            <i class="bi bi-check-lg text-primary"></i>
                        }
                    </button>
                </form>
            }
        }
        else
        {
            <div class="px-2 py-2 text-muted small">No workspaces yet.</div>
        }
        <hr class="dropdown-divider" />
        <a asp-controller="Workspace" asp-action="Create" class="dropdown-item rounded-3 px-2 py-2 fw-semibold text-primary">
            <i class="bi bi-plus-lg me-1"></i> New Workspace
        </a>
    </div>
</div>
