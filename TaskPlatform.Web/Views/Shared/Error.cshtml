@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="d-flex justify-content-center py-5">
    <div class="card border-0 shadow-sm rounded-4 bg-white text-center" style="max-width: 520px;">
        <div class="card-body p-5">
            <div class="avatar bg-danger-subtle text-danger mx-auto mb-3" style="width: 64px; height: 64px; font-size: 2rem;">
                <i class="bi bi-exclamation-triangle-fill"></i>
            </div>
            <h3 class="fw-bold text-dark mb-2">Something Went Wrong</h3>
            <p class="text-secondary small mb-4">
                An unexpected error occurred while processing your request. Please try again, and if the problem persists, contact support.
            </p>

            @if (Model.ShowRequestId)
            {
                <p class="extra-small text-muted mb-4">
                    <strong>Request ID:</strong> <code>@Model.RequestId</code>
                </p>
            }

            <a href="/Dashboard/Index" class="btn btn-gradient px-4">
                <i class="bi bi-house-door me-1"></i> Back to Dashboard
            </a>
        </div>
    </div>
</div>
