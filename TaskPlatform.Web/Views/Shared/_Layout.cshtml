@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="request-verification-token" content="@Antiforgery.GetAndStoreTokens(Context).RequestToken" />
    @if (User.Identity?.IsAuthenticated == true)
    {
        <meta name="access-token" content="@User.FindFirst("AccessToken")?.Value" />
        <meta name="api-base-url" content="@(Configuration["ApiBaseUrl"] ?? "https://localhost:7030")" />
    }
    <title>@ViewData["Title"] - TaskPlatform</title>
    
    <!-- Google Fonts Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Bootstrap 5 & Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet" />

    <!-- Site CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="@(User.Identity?.IsAuthenticated == true ? "app-layout-with-sidebar" : "")">
    <nav class="navbar navbar-expand-lg sticky-top glass-nav py-2 border-bottom shadow-xs">
        <div class="container-fluid px-3">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <button type="button" id="mobileSidebarToggle" class="btn btn-light rounded-circle border-0 shadow-xs me-2 d-md-none" title="Toggle Sidebar">
                    <i class="bi bi-list fs-5"></i>
                </button>
            }

            <!-- Brand Logo -->
            <a class="navbar-brand brand-logo me-4 d-flex align-items-center gap-2" href="/Dashboard/Index">
                <div class="avatar avatar-sm bg-gradient text-white shadow-sm" style="background: var(--color-primary);">
                    <i class="bi bi-kanban"></i>
                </div>
                <span class="fw-extrabold tracking-tight">TaskPlatform</span>
            </a>

            <div class="d-flex align-items-center gap-3 ms-auto">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <!-- Dark / Light Theme Mode Toggle Button -->
                    <button type="button" id="themeToggleBtn" class="btn btn-light rounded-circle p-2 border-0 shadow-xs" title="Toggle Light/Dark Theme">
                        <i id="themeToggleIcon" class="bi bi-moon-stars fs-5 text-secondary"></i>
                    </button>

                    <!-- Sticky Active Timer Widget -->
                    <div class="dropdown d-none" id="activeTimerWidget">
                        <button class="btn btn-light rounded-pill px-3 py-1 border d-flex align-items-center gap-2 shadow-xs timer-pulse" type="button" id="activeTimerBtn" data-bs-toggle="dropdown" aria-expanded="false" title="Active Timer">
                            <i class="bi bi-stopwatch-fill text-primary"></i>
                            <span id="activeTimerElapsed" class="fw-bold small text-dark" data-timer-elapsed>00:00:00</span>
                        </button>
                        <div class="dropdown-menu dropdown-menu-end shadow-xl border-0 rounded-4 p-3" style="width: 280px;" aria-labelledby="activeTimerBtn">
                            <div class="small text-muted fw-bold text-uppercase tracking-wider mb-1">Tracking</div>
                            <div id="activeTimerTaskTitle" class="fw-bold text-dark mb-3 text-truncate">—</div>
                            <div class="d-flex gap-2">
                                <a id="activeTimerViewTaskLink" href="#" class="btn btn-outline-custom btn-sm flex-fill">
                                    <i class="bi bi-eye me-1"></i>View Task
                                </a>
                                <button type="button" class="btn btn-danger btn-sm flex-fill" data-timer-stop>
                                    <i class="bi bi-stop-fill me-1"></i>Stop
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Notification Dropdown -->
                    <div class="dropdown">
                        <button class="btn btn-light rounded-circle p-2 position-relative border-0 shadow-xs" type="button" id="notificationBell" data-bs-toggle="dropdown" aria-expanded="false" title="Notifications">
                            <i class="bi bi-bell fs-5 text-secondary"></i>
                            <span id="notificationBadge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger d-none" style="font-size: 0.6rem;">0</span>
                        </button>
                        <div class="dropdown-menu dropdown-menu-end shadow-xl border-0 rounded-4 p-0 mt-2" style="width: 360px;" aria-labelledby="notificationBell">
                            <div class="d-flex justify-content-between align-items-center px-3 py-3 border-bottom bg-light rounded-top-4">
                                <span class="fw-bold text-dark"><i class="bi bi-bell-fill text-primary me-2"></i>Notifications</span>
                                <a asp-controller="Notifications" asp-action="Index" class="small text-primary text-decoration-none fw-bold">View All</a>
                            </div>
                            <ul id="notificationDropdownList" class="list-unstyled mb-0" style="max-height: 320px; overflow-y: auto;">
                                <li id="notificationEmptyState" class="px-3 py-4 text-center text-muted small">No new notifications</li>
                            </ul>
                        </div>
                    </div>

                    <!-- User Profile Dropdown -->
                    <div class="dropdown">
                        <button class="btn btn-light rounded-pill px-3 py-1 border d-flex align-items-center gap-2 shadow-xs" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <div class="avatar avatar-sm bg-primary text-white font-bold">
                                @(User.Identity.Name?.Substring(0, 1).ToUpper() ?? "U")
                            </div>
                            <span class="fw-bold small text-dark d-none d-md-inline">@User.Identity.Name</span>
                            <i class="bi bi-chevron-down small text-muted"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow-xl border-0 rounded-3 mt-2">
                            <li>
                                <a class="dropdown-item py-2 fw-semibold" asp-controller="Users" asp-action="Profile">
                                    <i class="bi bi-person-circle me-2 text-primary"></i> My Profile
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item py-2 fw-semibold" asp-controller="Workspace" asp-action="Index">
                                    <i class="bi bi-building me-2 text-primary"></i> Workspaces
                                </a>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <form asp-controller="Auth" asp-action="Logout" method="post" class="px-2">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-danger btn-sm w-100 rounded-pill fw-semibold">
                                        <i class="bi bi-box-arrow-right me-1"></i> Log Out
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>
                }
                else
                {
                    <div class="d-flex align-items-center gap-2">
                        <button type="button" id="themeToggleBtn" class="btn btn-light rounded-circle p-2 border-0 shadow-xs me-2" title="Toggle Theme">
                            <i id="themeToggleIcon" class="bi bi-moon-stars fs-5 text-secondary"></i>
                        </button>
                        <a asp-controller="Auth" asp-action="Login" class="btn btn-outline-custom px-4 py-2">Log In</a>
                        <a asp-controller="Auth" asp-action="Register" class="btn btn-gradient px-4 py-2 shadow-sm">Get Started Free</a>
                    </div>
                }
            </div>
        </div>
    </nav>

    <div class="app-viewport d-flex flex-grow-1">
        @if (User.Identity?.IsAuthenticated == true)
        {
            @await Html.PartialAsync("_Sidebar")
        }

        <main class="app-main-content flex-grow-1 py-4">
            <div class="container-fluid px-4">
                @RenderBody()
            </div>
        </main>
    </div>

    <footer class="footer py-3 text-center mt-auto border-top">
        <div class="container-fluid px-4 d-flex flex-column flex-sm-row justify-content-between align-items-center text-muted small">
            <span>&copy; @DateTime.UtcNow.Year <strong>TaskPlatform</strong>. All rights reserved.</span>
            <div class="d-flex gap-3 mt-2 mt-sm-0">
                <a href="javascript:void(0)" class="text-muted text-decoration-none">Privacy Policy</a>
                <a href="javascript:void(0)" class="text-muted text-decoration-none">Terms of Service</a>
                <a href="javascript:void(0)" class="text-muted text-decoration-none">Help & Support</a>
            </div>
        </div>
    </footer>

    <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 1080;" id="toastContainer"></div>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <!-- Stop Timer Modal -->
        <div class="modal fade" id="stopTimerModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content rounded-4 border-0 shadow-xl">
                    <div class="modal-header border-0 pb-0">
                        <h5 class="modal-title fw-bold"><i class="bi bi-stop-circle-fill text-danger me-2"></i>Stop Timer</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <label class="form-label small fw-semibold text-muted">Notes (optional)</label>
                        <textarea id="stopTimerNotes" class="form-control" rows="3" placeholder="What did you work on?"></textarea>
                    </div>
                    <div class="modal-footer border-0 pt-0">
                        <button type="button" class="btn btn-outline-custom rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
                        <button type="button" id="stopTimerConfirmBtn" class="btn btn-danger rounded-pill px-3">
                            <i class="bi bi-stop-fill me-1"></i>Stop Timer
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Attachment Lightbox Preview Modal -->
        <div class="modal fade" id="attachmentPreviewModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-xl">
                <div class="modal-content rounded-4 border-0 shadow-xl overflow-hidden">
                    <div class="modal-header border-bottom bg-light py-3 px-4">
                        <h5 id="previewModalTitle" class="modal-title fw-bold text-dark me-auto text-truncate">—</h5>
                        <a id="previewModalDownloadBtn" href="#" class="btn btn-sm btn-outline-primary rounded-pill me-2 px-3">
                            <i class="bi bi-download me-1"></i> Download
                        </a>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body p-0 d-flex justify-content-center align-items-center bg-dark-subtle" style="min-height: 480px; max-height: 80vh;">
                        <div id="previewContainer" class="w-100 h-100 d-flex justify-content-center align-items-center p-3">
                            <!-- Injected dynamically via site.js -->
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@8.0.7/dist/browser/signalr.min.js"></script>
        <script src="~/js/notifications.js" asp-append-version="true"></script>
        <script src="~/js/time-tracking.js" asp-append-version="true"></script>
    }

    <!-- Page-level feedback: TempData success/error messages become toasts -->
    @if (TempData["SuccessMessage"] != null)
    {
        <script>document.addEventListener('DOMContentLoaded', function () { showToast(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["SuccessMessage"])), 'success'); });</script>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <script>document.addEventListener('DOMContentLoaded', function () { showToast(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["ErrorMessage"])), 'danger'); });</script>
    }

    <!-- Theme Toggle Script -->
    <script>
        (function() {
            var toggleBtn = document.getElementById('themeToggleBtn');
            var toggleIcon = document.getElementById('themeToggleIcon');
            var currentTheme = localStorage.getItem('taskPlatformTheme') || 'light';

            if (currentTheme === 'dark') {
                document.documentElement.setAttribute('data-theme', 'dark');
                document.documentElement.setAttribute('data-bs-theme', 'dark');
                if (toggleIcon) toggleIcon.className = 'bi bi-sun-fill fs-5 text-warning';
            }

            toggleBtn?.addEventListener('click', function() {
                var theme = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
                document.documentElement.setAttribute('data-theme', theme);
                document.documentElement.setAttribute('data-bs-theme', theme);
                localStorage.setItem('taskPlatformTheme', theme);
                if (toggleIcon) {
                    toggleIcon.className = theme === 'dark' ? 'bi bi-sun-fill fs-5 text-warning' : 'bi bi-moon-stars fs-5 text-secondary';
                }
            });
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
