@model TaskPlatform.Shared.ViewModels.TimeTracking.TimeTrackingReportViewModel
@using TaskPlatform.Shared.ViewModels.Workspace
@{
    ViewData["Title"] = "Time Tracking Report";
    var currentWorkspace = ViewBag.CurrentWorkspace as WorkspaceViewModel;
    var range = ViewBag.Range as string ?? "today";
    DateTime from = ViewBag.From;
    DateTime to = ViewBag.To;

    string RangeUrl(string r) => Url.Action("Report", new { workspaceId = currentWorkspace?.Id, range = r }) ?? "#";
}

<div class="py-2">
    <!-- Header Banner -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-3 border-bottom gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <h3 class="fw-extrabold text-dark mb-0">
                    <i class="bi bi-stopwatch-fill text-primary me-2"></i>Owner Audit Dashboard
                </h3>
                <span class="badge bg-primary-subtle text-primary border rounded-pill px-3 fw-bold">@currentWorkspace?.Name</span>
            </div>
            <p class="text-secondary small mb-0">Time tracking across every project and team member in this workspace. Use the workspace switcher in the navbar to change workspace.</p>
        </div>
    </div>

    <!-- Date Range Filter -->
    <div class="d-flex flex-wrap align-items-center gap-2 mb-4">
        <div class="btn-group shadow-xs" role="group">
            <a href="@RangeUrl("today")" class="btn btn-sm @(range == "today" ? "btn-dark-custom" : "btn-outline-custom")">Today</a>
            <a href="@RangeUrl("week")" class="btn btn-sm @(range == "week" ? "btn-dark-custom" : "btn-outline-custom")">This Week</a>
            <a href="@RangeUrl("month")" class="btn btn-sm @(range == "month" ? "btn-dark-custom" : "btn-outline-custom")">This Month</a>
            <a href="#" id="customRangeToggle" class="btn btn-sm @(range == "custom" ? "btn-dark-custom" : "btn-outline-custom")">Custom</a>
        </div>

        <form method="get" asp-action="Report" id="customRangeForm" class="d-flex align-items-center gap-2 @(range == "custom" ? "" : "d-none")">
            <input type="hidden" name="workspaceId" value="@currentWorkspace?.Id" />
            <input type="hidden" name="range" value="custom" />
            <input type="date" name="from" value="@from.ToString("yyyy-MM-dd")" class="form-control form-control-sm rounded-pill shadow-xs" />
            <span class="text-muted small">to</span>
            <input type="date" name="to" value="@to.ToString("yyyy-MM-dd")" class="form-control form-control-sm rounded-pill shadow-xs" />
            <button type="submit" class="btn btn-sm btn-gradient rounded-pill px-3">Apply</button>
        </form>
    </div>

    <!-- Summary Metric Cards -->
    <div class="row g-3 mb-4">
        <div class="col-xl-4 col-md-6">
            <div class="card card-hover border-0 shadow-sm rounded-4 h-100 bg-white">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <span class="text-muted extra-small font-bold text-uppercase tracking-wider">Total Hours Logged</span>
                    </div>
                    <div class="d-flex align-items-center justify-content-between mt-2">
                        <h2 class="fw-extrabold text-dark mb-0 fs-1">@Model.TotalHoursLogged.ToString("0.##")</h2>
                        <div class="avatar bg-primary-subtle text-primary" style="width: 52px; height: 52px; font-size: 1.4rem;">
                            <i class="bi bi-clock-history"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-4 col-md-6">
            <div class="card card-hover border-0 shadow-sm rounded-4 h-100 bg-white">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <span class="text-muted extra-small font-bold text-uppercase tracking-wider">Active Users Currently Tracking</span>
                    </div>
                    <div class="d-flex align-items-center justify-content-between mt-2">
                        <h2 class="fw-extrabold text-dark mb-0 fs-1">@Model.ActiveUsersCurrentlyTracking</h2>
                        <div class="avatar bg-success-subtle text-success" style="width: 52px; height: 52px; font-size: 1.4rem;">
                            <i class="bi bi-broadcast"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-4 col-md-6">
            <div class="card card-hover border-0 shadow-sm rounded-4 h-100 bg-white">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <span class="text-muted extra-small font-bold text-uppercase tracking-wider">Most Active Project</span>
                    </div>
                    <div class="d-flex align-items-center justify-content-between mt-2">
                        <h4 class="fw-extrabold text-dark mb-0 text-truncate" title="@Model.MostActiveProject">@Model.MostActiveProject</h4>
                        <div class="avatar bg-warning-subtle text-warning" style="width: 52px; height: 52px; font-size: 1.4rem;">
                            <i class="bi bi-folder2-open"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Detailed Breakdown Table -->
    @if (!Model.Rows.Any())
    {
        <div class="card border-0 shadow-sm rounded-4 text-center py-5 bg-white my-3">
            <div class="card-body">
                <div class="avatar bg-primary-subtle text-primary mx-auto mb-3" style="width: 64px; height: 64px; font-size: 2rem;">
                    <i class="bi bi-hourglass-split"></i>
                </div>
                <h4 class="fw-bold text-dark">No Time Logged</h4>
                <p class="text-secondary small mb-0">No timers were tracked in this workspace for the selected date range.</p>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light border-bottom">
                        <tr class="text-secondary small fw-bold">
                            <th class="ps-4 py-3">TEAM MEMBER</th>
                            <th class="py-3">TASK NAME</th>
                            <th class="py-3">PROJECT</th>
                            <th class="py-3">START TIME</th>
                            <th class="py-3">END TIME</th>
                            <th class="py-3">DURATION</th>
                            <th class="pe-4 py-3">NOTES</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y">
                        @foreach (var row in Model.Rows)
                        {
                            <tr>
                                <td class="ps-4 py-3 fw-bold text-dark">@row.TeamMember</td>
                                <td class="py-3">@row.TaskName</td>
                                <td class="py-3">
                                    <span class="badge bg-light text-dark border rounded-pill">
                                        <i class="bi bi-folder2 me-1 text-primary"></i>@row.ProjectName
                                    </span>
                                </td>
                                <td class="py-3 small text-secondary">@row.StartTime.ToString("MMM dd, yyyy HH:mm")</td>
                                <td class="py-3 small text-secondary">@(row.EndTime.HasValue ? row.EndTime.Value.ToString("MMM dd, yyyy HH:mm") : "Running")</td>
                                <td class="py-3 fw-semibold">@(row.DurationMinutes.HasValue ? $"{row.DurationMinutes / 60}h {row.DurationMinutes % 60}m" : "—")</td>
                                <td class="pe-4 py-3 small text-secondary">@(string.IsNullOrWhiteSpace(row.Notes) ? "—" : row.Notes)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        (function () {
            var toggle = document.getElementById('customRangeToggle');
            var form = document.getElementById('customRangeForm');
            if (!toggle || !form) return;
            toggle.addEventListener('click', function (e) {
                e.preventDefault();
                form.classList.toggle('d-none');
            });
        })();
    </script>
}
