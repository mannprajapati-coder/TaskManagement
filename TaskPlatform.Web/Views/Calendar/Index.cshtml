@{
    ViewData["Title"] = "Calendar";
    var workspaces = ViewBag.Workspaces as List<TaskPlatform.Shared.ViewModels.Workspace.WorkspaceViewModel> ?? new List<TaskPlatform.Shared.ViewModels.Workspace.WorkspaceViewModel>();
    var currentWorkspace = ViewBag.CurrentWorkspace as TaskPlatform.Shared.ViewModels.Workspace.WorkspaceViewModel;
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/index.global.min.css" />

<div class="py-2">
    <!-- Header Banner -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-3 border-bottom">
        <div>
            <h3 class="fw-extrabold text-dark mb-1">
                <i class="bi bi-calendar3 text-primary me-2"></i>Calendar & Timeline
            </h3>
            <p class="text-secondary small mb-0">View scheduled tasks, due dates, and drag to reschedule timelines.</p>
        </div>

        <div class="d-flex align-items-center gap-3">
            @if (workspaces.Any())
            {
                <form method="get" asp-action="Index" class="d-flex align-items-center">
                    <label class="form-label me-2 mb-0 small text-muted fw-semibold">Workspace:</label>
                    <select name="workspaceId" onchange="this.form.submit()" class="form-select form-select-sm rounded-pill shadow-sm" style="min-width: 210px;">
                        @foreach (var ws in workspaces)
                        {
                            <option value="@ws.Id" selected="@(currentWorkspace != null && currentWorkspace.Id == ws.Id)">@ws.Name</option>
                        }
                    </select>
                </form>
            }
        </div>
    </div>

    <!-- Status Legend Pills -->
    <div class="d-flex align-items-center gap-3 mb-4 bg-white p-3 rounded-4 border shadow-sm flex-wrap">
        <span class="small fw-bold text-dark me-2"><i class="bi bi-funnel-fill text-muted me-1"></i>Status Color Codes:</span>
        <span class="badge rounded-pill px-3 py-2 text-dark border" style="background-color: #e0e7ff;"><i class="bi bi-circle-fill me-1" style="color: #6366f1;"></i> To Do</span>
        <span class="badge rounded-pill px-3 py-2 text-dark border" style="background-color: #fef3c7;"><i class="bi bi-circle-fill me-1" style="color: #f59e0b;"></i> In Progress</span>
        <span class="badge rounded-pill px-3 py-2 text-dark border" style="background-color: #f3e8ff;"><i class="bi bi-circle-fill me-1" style="color: #a855f7;"></i> Review</span>
        <span class="badge rounded-pill px-3 py-2 text-dark border" style="background-color: #d1fae5;"><i class="bi bi-circle-fill me-1" style="color: #10b981;"></i> Completed</span>
    </div>

    <!-- Calendar Container -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white p-3">
        <div id="calendar" data-workspace-id="@currentWorkspace?.Id" class="min-h-500"></div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/index.global.min.js"></script>
    <script src="~/js/calendar.js" asp-append-version="true"></script>
}
