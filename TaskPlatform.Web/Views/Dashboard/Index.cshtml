@model TaskPlatform.Shared.ViewModels.Dashboard.DashboardOverviewViewModel
@{
    ViewData["Title"] = "Analytics Dashboard";
    var workspaces = ViewBag.Workspaces as List<TaskPlatform.Shared.ViewModels.Workspace.WorkspaceViewModel> ?? new List<TaskPlatform.Shared.ViewModels.Workspace.WorkspaceViewModel>();
    var currentWorkspace = ViewBag.CurrentWorkspace as TaskPlatform.Shared.ViewModels.Workspace.WorkspaceViewModel;
}

<div class="py-2">
    <!-- Header Banner -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-3 border-bottom">
        <div>
            <h3 class="fw-extrabold text-dark mb-1">
                <i class="bi bi-grid-1x2-fill text-primary me-2"></i>Workspace Overview
            </h3>
            <p class="text-secondary small mb-0">Monitor tasks, workloads, deadlines, and project completion metrics.</p>
        </div>

        <div class="d-flex align-items-center gap-3">
            @if (workspaces.Any())
            {
                <form method="get" asp-action="Index" class="d-flex align-items-center">
                    <label class="form-label me-2 mb-0 small text-muted fw-semibold">Workspace:</label>
                    <select name="workspaceId" onchange="this.form.submit()" class="form-select form-select-sm rounded-pill shadow-sm" style="min-width: 210px;">
                        @foreach (var ws in workspaces)
                        {
                            <option value="@ws.Id" selected="@(currentWorkspace != null && currentWorkspace.Id == ws.Id)">@ws.Name</option>
                        }
                    </select>
                </form>
            }
            <a asp-controller="Project" asp-action="Index" asp-route-workspaceId="@currentWorkspace?.Id" class="btn btn-gradient btn-sm px-3 shadow-sm">
                <i class="bi bi-folder-fill me-1"></i> View Projects
            </a>
        </div>
    </div>

    <!-- Summary KPI Cards Row -->
    <div class="row g-3 mb-4">
        <!-- Total Tasks -->
        <div class="col-xl-3 col-md-6">
            <div class="card card-hover border-0 shadow-sm rounded-4 h-100 bg-white">
                <div class="card-body p-4 d-flex align-items-center">
                    <div class="avatar bg-primary-subtle text-primary me-3" style="width: 54px; height: 54px; font-size: 1.5rem;">
                        <i class="bi bi-list-check"></i>
                    </div>
                    <div>
                        <span class="text-muted extra-small d-block fw-bold text-uppercase tracking-wider">Total Tasks</span>
                        <h2 class="fw-extrabold text-dark mb-0">@Model.TotalTasks</h2>
                    </div>
                </div>
            </div>
        </div>

        <!-- Completed Tasks -->
        <div class="col-xl-3 col-md-6">
            <div class="card card-hover border-0 shadow-sm rounded-4 h-100 bg-white">
                <div class="card-body p-4 d-flex align-items-center">
                    <div class="avatar bg-success-subtle text-success me-3" style="width: 54px; height: 54px; font-size: 1.5rem;">
                        <i class="bi bi-check-circle-fill"></i>
                    </div>
                    <div>
                        <span class="text-muted extra-small d-block fw-bold text-uppercase tracking-wider">Completed</span>
                        <h2 class="fw-extrabold text-dark mb-0">@Model.CompletedTasks</h2>
                    </div>
                </div>
            </div>
        </div>

        <!-- In Progress -->
        <div class="col-xl-3 col-md-6">
            <div class="card card-hover border-0 shadow-sm rounded-4 h-100 bg-white">
                <div class="card-body p-4 d-flex align-items-center">
                    <div class="avatar bg-warning-subtle text-warning me-3" style="width: 54px; height: 54px; font-size: 1.5rem;">
                        <i class="bi bi-arrow-repeat"></i>
                    </div>
                    <div>
                        <span class="text-muted extra-small d-block fw-bold text-uppercase tracking-wider">In Progress</span>
                        <h2 class="fw-extrabold text-dark mb-0">@Model.InProgressTasks</h2>
                    </div>
                </div>
            </div>
        </div>

        <!-- Overdue Tasks -->
        <div class="col-xl-3 col-md-6">
            <div class="card card-hover border-0 shadow-sm rounded-4 h-100 bg-white">
                <div class="card-body p-4 d-flex align-items-center">
                    <div class="avatar bg-danger-subtle text-danger me-3" style="width: 54px; height: 54px; font-size: 1.5rem;">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                    </div>
                    <div>
                        <span class="text-muted extra-small d-block fw-bold text-uppercase tracking-wider">Overdue</span>
                        <h2 class="fw-extrabold text-dark mb-0">@Model.OverdueTasks</h2>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Completion Rate & Upcoming Deadlines -->
    <div class="row g-4 mb-4">
        <!-- Completion Rate Progress -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="fw-bold text-dark mb-0"><i class="bi bi-pie-chart-fill text-primary me-2"></i> Workspace Progress Rate</h5>
                        <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-2 fw-bold">@Model.CompletionRatePercentage% Done</span>
                    </div>

                    <div class="progress progress-sm rounded-pill mb-4" style="height: 14px;">
                        <div class="progress-bar progress-bar-gradient" role="progressbar" style="width: @(Model.CompletionRatePercentage)%;" aria-valuenow="@Model.CompletionRatePercentage" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>

                    <div class="row text-center g-3 mt-2">
                        <div class="col-4">
                            <div class="p-3 border rounded-3 bg-light">
                                <span class="extra-small text-muted d-block font-semibold">Pending</span>
                                <h5 class="fw-bold text-secondary mb-0">@Model.PendingTasks</h5>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="p-3 border rounded-3 bg-light">
                                <span class="extra-small text-muted d-block font-semibold">In Progress</span>
                                <h5 class="fw-bold text-warning mb-0">@Model.InProgressTasks</h5>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="p-3 border rounded-3 bg-light">
                                <span class="extra-small text-muted d-block font-semibold">Completed</span>
                                <h5 class="fw-bold text-success mb-0">@Model.CompletedTasks</h5>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Upcoming Task Deadlines -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="fw-bold text-dark mb-0"><i class="bi bi-calendar-event-fill text-primary me-2"></i> Upcoming Deadlines</h5>
                        <a asp-controller="Calendar" asp-action="Index" class="small text-primary text-decoration-none fw-semibold">View Calendar</a>
                    </div>
                    
                    @if (Model.UpcomingTasks != null && Model.UpcomingTasks.Any())
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var task in Model.UpcomingTasks)
                            {
                                <div class="list-group-item d-flex justify-content-between align-items-center px-0 py-3 border-bottom bg-transparent">
                                    <div>
                                        <a asp-controller="Task" asp-action="Detail" asp-route-id="@task.Id" class="fw-bold text-dark text-decoration-none hover-primary">@task.Title</a>
                                        <div class="extra-small text-muted mt-1"><i class="bi bi-clock me-1"></i> Due: @(task.DueDate?.ToString("MMM dd, yyyy") ?? "No date specified")</div>
                                    </div>
                                    <span class="badge-status badge-inprogress">@task.Status</span>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4 text-muted">
                            <div class="avatar bg-success-subtle text-success mx-auto mb-3" style="width: 54px; height: 54px; font-size: 1.5rem;">
                                <i class="bi bi-check-all"></i>
                            </div>
                            <h6 class="fw-bold text-dark mb-1">All Caught Up!</h6>
                            <p class="small text-secondary mb-0">No upcoming tasks due soon in this workspace.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
