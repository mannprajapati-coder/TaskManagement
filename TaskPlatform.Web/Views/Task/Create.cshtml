@model TaskPlatform.Shared.ViewModels.Task.CreateTaskRequestViewModel
@{
    ViewData["Title"] = "Create Task";
}

<div class="auth-wrapper py-4">
    <div class="auth-card" style="max-width: 560px;">
        <div class="text-center mb-4">
            <h3 class="fw-bold text-dark mb-1">Create New Task</h3>
            <p class="text-muted small">Add a new task to your project backlog</p>
        </div>

        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ProjectId" />
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

            <div class="mb-3">
                <label asp-for="Title" class="form-label small fw-semibold">Task Title</label>
                <input asp-for="Title" class="form-control" placeholder="e.g. Implement User Authentication" required />
                <span asp-validation-for="Title" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label small fw-semibold">Description</label>
                <textarea asp-for="Description" class="form-control" rows="3" placeholder="Task details and technical acceptance criteria..."></textarea>
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>

            <div class="row g-2 mb-3">
                <div class="col-md-6">
                    <label asp-for="Priority" class="form-label small fw-semibold">Priority</label>
                    <select asp-for="Priority" class="form-select">
                        <option value="Low">Low</option>
                        <option value="Medium" selected>Medium</option>
                        <option value="High">High</option>
                        <option value="Urgent">Urgent</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label asp-for="EstimatedHours" class="form-label small fw-semibold">Estimated Hours</label>
                    <input type="number" step="0.5" asp-for="EstimatedHours" class="form-control" placeholder="e.g. 8" />
                </div>
            </div>

            <div class="row g-2 mb-4">
                <div class="col-md-6">
                    <label asp-for="StartDate" class="form-label small fw-semibold">Start Date</label>
                    <input type="date" asp-for="StartDate" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="DueDate" class="form-label small fw-semibold">Due Date</label>
                    <input type="date" asp-for="DueDate" class="form-control" />
                </div>
            </div>

            <div class="d-flex gap-2">
                <a asp-action="Index" asp-route-projectId="@Model.ProjectId" class="btn btn-outline-secondary w-50">Cancel</a>
                <button type="submit" class="btn btn-gradient w-50">Create Task <i class="bi bi-check-lg"></i></button>
            </div>
        </form>
    </div>
</div>
