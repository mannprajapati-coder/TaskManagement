@model TaskPlatform.Shared.ViewModels.Task.CreateTaskRequestViewModel
@using TaskPlatform.Shared.ViewModels.Project
@{
    ViewData["Title"] = "Create Task";
    var projectMembers = ViewBag.ProjectMembers as List<ProjectMemberViewModel> ?? new List<ProjectMemberViewModel>();
}

<div class="py-2 py-md-3">
    <div class="card border-0 shadow-lg rounded-4 overflow-hidden bg-white mx-auto" style="max-width: 600px;">
        <!-- Brand Header -->
        <div class="p-3 p-md-4 text-white" style="background: var(--primary-gradient);">
            <div class="d-flex align-items-center gap-3">
                <div class="avatar bg-white text-primary fw-extrabold shadow-xs" style="width: 44px; height: 44px; font-size: 1.25rem;">
                    <i class="bi bi-plus-circle-fill"></i>
                </div>
                <div>
                    <h4 class="fw-extrabold text-white mb-0">Create New Task</h4>
                    <p class="text-white text-opacity-90 extra-small mb-0">Add a new task to your project backlog.</p>
                </div>
            </div>
        </div>

        <!-- Form Body -->
        <div class="card-body p-3 p-md-4">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ProjectId" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger small p-2 rounded-3 mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Title" class="form-label small fw-bold text-dark">Task Title</label>
                    <input asp-for="Title" class="form-control" placeholder="e.g. Implement User Authentication" required />
                    <span asp-validation-for="Title" class="text-danger extra-small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label small fw-bold text-dark">Description</label>
                    <textarea asp-for="Description" class="form-control" rows="2" placeholder="Task details and technical acceptance criteria..."></textarea>
                    <span asp-validation-for="Description" class="text-danger extra-small"></span>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="Priority" class="form-label small fw-bold text-dark">Priority</label>
                        <select asp-for="Priority" class="form-select">
                            <option value="Low">Low</option>
                            <option value="Medium" selected>Medium</option>
                            <option value="High">High</option>
                            <option value="Urgent">Urgent</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="EstimatedHours" class="form-label small fw-bold text-dark">Estimated Hours</label>
                        <input type="number" step="0.5" asp-for="EstimatedHours" class="form-control" placeholder="e.g. 8" />
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="StartDate" class="form-label small fw-bold text-dark">Start Date</label>
                        <input type="date" asp-for="StartDate" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="DueDate" class="form-label small fw-bold text-dark">Due Date</label>
                        <input type="date" asp-for="DueDate" class="form-control" />
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="PrimaryAssigneeUserId" class="form-label small fw-bold text-dark">Assign To</label>
                    <select asp-for="PrimaryAssigneeUserId" class="form-select">
                        <option value="">Unassigned</option>
                        @foreach (var m in projectMembers)
                        {
                            <option value="@m.UserId">@m.FullName (@m.Email)</option>
                        }
                    </select>
                </div>

                <div class="d-flex gap-2">
                    <a asp-action="Index" asp-route-projectId="@Model.ProjectId" class="btn btn-outline-custom w-50 py-2">Cancel</a>
                    <button type="submit" class="btn btn-gradient w-50 py-2 shadow-sm font-semibold">
                        Create Task <i class="bi bi-check-lg ms-1"></i>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
