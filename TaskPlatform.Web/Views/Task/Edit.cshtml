@model TaskPlatform.Shared.ViewModels.Task.UpdateTaskRequestViewModel
@using TaskPlatform.Shared.ViewModels.Project
@{
    ViewData["Title"] = "Edit Task";
    var projectMembers = ViewBag.ProjectMembers as List<ProjectMemberViewModel> ?? new List<ProjectMemberViewModel>();
    var projectId = ViewBag.ProjectId as Guid?;
}

<div class="auth-wrapper py-4">
    <div class="auth-card" style="max-width: 560px;">
        <div class="text-center mb-4">
            <h3 class="fw-bold text-dark mb-1">Edit Task</h3>
            <p class="text-muted small">Update task details and assignment</p>
        </div>

        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="TaskId" />
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

            <div class="mb-3">
                <label asp-for="Title" class="form-label small fw-semibold">Task Title</label>
                <input asp-for="Title" class="form-control" required />
                <span asp-validation-for="Title" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label small fw-semibold">Description</label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>

            <div class="row g-2 mb-3">
                <div class="col-md-6">
                    <label asp-for="Priority" class="form-label small fw-semibold">Priority</label>
                    <select asp-for="Priority" class="form-select">
                        <option value="Low">Low</option>
                        <option value="Medium">Medium</option>
                        <option value="High">High</option>
                        <option value="Urgent">Urgent</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label asp-for="EstimatedHours" class="form-label small fw-semibold">Estimated Hours</label>
                    <input type="number" step="0.5" asp-for="EstimatedHours" class="form-control" />
                </div>
            </div>

            <div class="row g-2 mb-3">
                <div class="col-md-6">
                    <label asp-for="StartDate" class="form-label small fw-semibold">Start Date</label>
                    <input type="date" asp-for="StartDate" class="form-control" value="@Model.StartDate?.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-md-6">
                    <label asp-for="DueDate" class="form-label small fw-semibold">Due Date</label>
                    <input type="date" asp-for="DueDate" class="form-control" value="@Model.DueDate?.ToString("yyyy-MM-dd")" />
                </div>
            </div>

            <div class="mb-4">
                <label asp-for="PrimaryAssigneeUserId" class="form-label small fw-semibold">Assign To</label>
                <select asp-for="PrimaryAssigneeUserId" class="form-select">
                    <option value="">Unassigned</option>
                    @foreach (var m in projectMembers)
                    {
                        <option value="@m.UserId" selected="@(Model.PrimaryAssigneeUserId == m.UserId)">@m.FullName (@m.Email)</option>
                    }
                </select>
            </div>

            <div class="d-flex gap-2">
                <a asp-action="Detail" asp-route-id="@Model.TaskId" class="btn btn-outline-secondary w-50">Cancel</a>
                <button type="submit" class="btn btn-gradient w-50">Save Changes <i class="bi bi-check-lg"></i></button>
            </div>
        </form>
    </div>
</div>
