@model List<TaskPlatform.Shared.ViewModels.Task.TaskViewModel>
@using TaskPlatform.Shared.ViewModels.Project
@{
    ViewData["Title"] = "My Tasks";
    var projectLookup = ViewBag.ProjectLookup as Dictionary<Guid, ProjectViewModel> ?? new Dictionary<Guid, ProjectViewModel>();
    var currentProjectId = ViewBag.CurrentProjectId as string;

    string ProjectName(Guid projectId) => projectLookup.TryGetValue(projectId, out var p) ? p.Name : "Unknown Project";
}

<div class="container-fluid py-4 px-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h3 class="fw-bold mb-1"><i class="bi bi-person-check text-primary me-2"></i>My Tasks</h3>
            <p class="text-muted small mb-0">Tasks assigned to you across all your projects.</p>
        </div>

        @if (projectLookup.Any())
        {
            <form method="get" asp-action="MyTasks" class="d-flex align-items-center">
                <label class="form-label me-2 mb-0 extra-small text-muted fw-semibold">Project:</label>
                <select name="projectId" onchange="this.form.submit()" class="form-select form-select-sm rounded-pill shadow-sm" style="min-width: 220px;">
                    <option value="">All Projects</option>
                    @foreach (var kvp in projectLookup.OrderBy(p => p.Value.Name))
                    {
                        <option value="@kvp.Key" selected="@(currentProjectId == kvp.Key.ToString())">@kvp.Value.Name</option>
                    }
                </select>
            </form>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5 bg-white rounded-4 border shadow-sm">
            <i class="bi bi-check-all text-muted display-4"></i>
            <h4 class="fw-bold mt-3">No Tasks Assigned</h4>
            <p class="text-muted small mb-0">
                @(string.IsNullOrEmpty(currentProjectId) ? "You don't have any tasks assigned to you yet." : "No tasks assigned to you in this project.")
            </p>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-4">
            <ul class="list-group list-group-flush">
                @foreach (var task in Model)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center px-4 py-3">
                        <div>
                            <a asp-action="Detail" asp-route-id="@task.Id" class="fw-semibold text-dark text-decoration-none hover-primary">@task.Title</a>
                            <div class="extra-small text-muted mt-1">
                                <i class="bi bi-folder2 me-1"></i>@ProjectName(task.ProjectId)
                                <span class="mx-2">&middot;</span>
                                <i class="bi bi-calendar-event me-1"></i>Due: @(task.DueDate?.ToString("MMM dd, yyyy") ?? "Not Set")
                            </div>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge @TaskStatusDisplay.GetPriorityBadgeClass(task.Priority) rounded-pill">@task.Priority</span>
                            <span class="badge @TaskStatusDisplay.GetBadgeClass(task.Status) rounded-pill">@TaskStatusDisplay.GetLabel(task.Status)</span>
                        </div>
                    </li>
                }
            </ul>
        </div>
    }
</div>
