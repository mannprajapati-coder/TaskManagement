@model List<TaskPlatform.Shared.ViewModels.Task.TaskViewModel>
@using TaskPlatform.Shared.ViewModels.Project
@{
    ViewData["Title"] = "My Tasks";
    var projectLookup = ViewBag.ProjectLookup as Dictionary<Guid, ProjectViewModel> ?? new Dictionary<Guid, ProjectViewModel>();
    var currentProjectId = ViewBag.CurrentProjectId as string;

    string ProjectName(Guid projectId) => projectLookup.TryGetValue(projectId, out var p) ? p.Name : "Project Workspace";
}

<div class="py-2">
    <!-- Header Banner -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-3 border-bottom">
        <div>
            <h3 class="fw-extrabold text-dark mb-1">
                <i class="bi bi-check2-square text-primary me-2"></i>My Assigned Workload
            </h3>
            <p class="text-secondary small mb-0">Overview of all tasks assigned to you across your active projects.</p>
        </div>

        <div class="d-flex align-items-center gap-3">
            @if (projectLookup.Any())
            {
                <form method="get" asp-action="MyTasks" class="d-flex align-items-center">
                    <label class="form-label me-2 mb-0 small text-muted fw-semibold">Filter Project:</label>
                    <select name="projectId" onchange="this.form.submit()" class="form-select form-select-sm rounded-pill shadow-sm" style="min-width: 220px;">
                        <option value="">All Assigned Projects</option>
                        @foreach (var kvp in projectLookup.OrderBy(p => p.Value.Name))
                        {
                            <option value="@kvp.Key" selected="@(currentProjectId == kvp.Key.ToString())">@kvp.Value.Name</option>
                        }
                    </select>
                </form>
            }
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm rounded-4 text-center py-5 bg-white my-3">
            <div class="card-body">
                <div class="avatar bg-success-subtle text-success mx-auto mb-3" style="width: 64px; height: 64px; font-size: 2rem;">
                    <i class="bi bi-check-all"></i>
                </div>
                <h4 class="fw-bold text-dark">No Pending Tasks</h4>
                <p class="text-secondary small mb-0">
                    @(string.IsNullOrEmpty(currentProjectId) ? "You have no assigned tasks pending. Great job!" : "No tasks assigned to you in this selected project.")
                </p>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light border-bottom">
                        <tr class="text-secondary small fw-bold">
                            <th class="ps-4 py-3">TASK TITLE</th>
                            <th class="py-3">PROJECT</th>
                            <th class="py-3">DUE DATE</th>
                            <th class="py-3">PRIORITY</th>
                            <th class="py-3">STATUS</th>
                            <th class="pe-4 text-end py-3">ACTION</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y">
                        @foreach (var task in Model)
                        {
                            <tr>
                                <td class="ps-4 py-3">
                                    <a asp-action="Detail" asp-route-id="@task.Id" class="fw-bold text-dark text-decoration-none hover-primary">
                                        @task.Title
                                    </a>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border rounded-pill">
                                        <i class="bi bi-folder2 me-1 text-primary"></i>@ProjectName(task.ProjectId)
                                    </span>
                                </td>
                                <td>
                                    <span class="small text-secondary">
                                        <i class="bi bi-calendar-event me-1"></i>@(task.DueDate?.ToString("MMM dd, yyyy") ?? "Not Set")
                                    </span>
                                </td>
                                <td>
                                    <span class="badge-status priority-@task.Priority?.ToLower()">@task.Priority</span>
                                </td>
                                <td>
                                    <span class="badge-status badge-@task.Status?.ToLower()">@task.Status</span>
                                </td>
                                <td class="pe-4 text-end">
                                    <a asp-action="Detail" asp-route-id="@task.Id" class="btn btn-sm btn-outline-custom px-3">
                                        View Details <i class="bi bi-arrow-right ms-1"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
