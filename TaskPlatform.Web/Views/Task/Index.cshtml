@model List<TaskPlatform.Shared.ViewModels.Task.TaskViewModel>
@{
    var project = ViewBag.Project as TaskPlatform.Shared.ViewModels.Project.ProjectViewModel;
    string? currentPriority = ViewBag.CurrentPriority as string;
    ViewData["Title"] = $"{project?.Name ?? "Project"} Tasks";
    var priorities = new[] { "Low", "Medium", "High", "Urgent" };
}

<div class="container-fluid py-4 px-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h3 class="fw-bold mb-1">Task Board</h3>
            <p class="text-muted small mb-0">Project tasks for <strong>@project?.Name</strong></p>
        </div>
        <div class="d-flex gap-2 flex-wrap align-items-center">
            <select id="priorityFilter" class="form-select form-select-sm rounded-pill" style="width: auto;">
                <option value="">All Priorities</option>
                @foreach (var p in priorities)
                {
                    <option value="@p" selected="@(currentPriority == p)">@p</option>
                }
            </select>
            <a asp-controller="Project" asp-action="Detail" asp-route-id="@project?.Id" class="btn btn-outline-secondary rounded-pill px-3"><i class="bi bi-arrow-left"></i> Project Overview</a>
            <a asp-action="Gantt" asp-route-projectId="@project?.Id" class="btn btn-outline-secondary rounded-pill px-3"><i class="bi bi-kanban-fill"></i> Gantt Chart</a>
            <a asp-action="Create" asp-route-projectId="@project?.Id" class="btn btn-gradient rounded-pill px-3"><i class="bi bi-plus-lg"></i> New Task</a>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5 bg-white rounded-4 border shadow-sm">
            <i class="bi bi-card-checklist text-muted display-4"></i>
            <h4 class="fw-bold mt-3">No Tasks Found</h4>
            <p class="text-muted small mb-4">Get started by creating your first task for this project</p>
            <a asp-action="Create" asp-route-projectId="@project?.Id" class="btn btn-gradient px-4 rounded-pill">Create Task</a>
        </div>
    }
    else
    {
        <div id="kanbanBoard" class="kanban-board d-flex gap-3" data-project-id="@project?.Id">
            @foreach (var status in TaskStatusDisplay.AllStatuses)
            {
                var columnTasks = Model.Where(t => t.Status == status).ToList();

                <div class="kanban-column">
                    <div class="d-flex justify-content-between align-items-center mb-2 px-1">
                        <h6 class="fw-bold mb-0">@TaskStatusDisplay.GetLabel(status)</h6>
                        <span class="badge bg-light text-dark border rounded-pill column-count">@columnTasks.Count</span>
                    </div>
                    <div class="kanban-column-body bg-white bg-opacity-50 rounded-4 border p-2 d-flex flex-column gap-2" data-status="@status">
                        @foreach (var task in columnTasks)
                        {
                            <div class="card task-card border-0 shadow-sm rounded-4 hover-shadow transition" draggable="true" data-task-id="@task.Id" data-status="@task.Status">
                                <div class="card-body p-3">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <h6 class="fw-bold text-dark mb-0">@task.Title</h6>
                                        <div class="dropdown">
                                            <button class="btn btn-sm btn-link text-muted p-0" type="button" data-bs-toggle="dropdown" aria-label="Task actions">
                                                <i class="bi bi-three-dots-vertical"></i>
                                            </button>
                                            <ul class="dropdown-menu dropdown-menu-end">
                                                <li><h6 class="dropdown-header">Move to</h6></li>
                                                @foreach (var target in TaskStatusDisplay.AllStatuses.Where(s => s != task.Status))
                                                {
                                                    <li>
                                                        <button type="button" class="dropdown-item move-task-btn" data-task-id="@task.Id" data-target-status="@target">
                                                            @TaskStatusDisplay.GetLabel(target)
                                                        </button>
                                                    </li>
                                                }
                                                <li><hr class="dropdown-divider"></li>
                                                <li><a class="dropdown-item" asp-action="Detail" asp-route-id="@task.Id">Open Task</a></li>
                                            </ul>
                                        </div>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <span class="badge @TaskStatusDisplay.GetPriorityBadgeClass(task.Priority) rounded-pill badge-sm">@task.Priority</span>
                                        <span class="extra-small text-muted">Due: @(task.DueDate?.ToString("MMM dd") ?? "No Date")</span>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                                        <div class="d-flex align-items-center gap-1 extra-small text-muted">
                                            <i class="bi bi-clock me-1"></i> @(task.ActualHours ?? 0) / @(task.EstimatedHours ?? 0) hrs
                                        </div>
                                        <a asp-action="Detail" asp-route-id="@task.Id" class="extra-small fw-semibold text-primary text-decoration-none">Open <i class="bi bi-arrow-right"></i></a>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
    <script src="~/js/task-board.js" asp-append-version="true"></script>
    <script>
        document.getElementById('priorityFilter')?.addEventListener('change', function () {
            var url = new URL(window.location.href);
            if (this.value) {
                url.searchParams.set('priority', this.value);
            } else {
                url.searchParams.delete('priority');
            }
            window.location.href = url.toString();
        });
    </script>
}
