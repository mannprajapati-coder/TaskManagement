@model List<TaskPlatform.Shared.ViewModels.Task.TaskViewModel>
@{
    var project = ViewBag.Project as TaskPlatform.Shared.ViewModels.Project.ProjectViewModel;
    string? currentPriority = ViewBag.CurrentPriority as string;
    ViewData["Title"] = $"{project?.Name ?? "Project"} Tasks";
    var priorities = new[] { "Low", "Medium", "High", "Urgent" };
}

<div class="py-2">
    <!-- Header Controls -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3 pb-3 border-bottom">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <h3 class="fw-extrabold text-dark mb-0">Interactive Kanban Board</h3>
                <span class="badge bg-primary-subtle text-primary rounded-pill px-3 fw-bold">@project?.Name</span>
            </div>
            <p class="text-secondary small mb-0">Drag & drop tasks between status columns or use quick action menus.</p>
        </div>

        <div class="d-flex gap-2 flex-wrap align-items-center">
            <select id="priorityFilter" class="form-select form-select-sm rounded-pill shadow-sm" style="width: 160px;">
                <option value="">All Priorities</option>
                @foreach (var p in priorities)
                {
                    <option value="@p" selected="@(currentPriority == p)">@p Priority</option>
                }
            </select>

            <a asp-controller="Project" asp-action="Detail" asp-route-id="@project?.Id" class="btn btn-outline-custom btn-sm px-3">
                <i class="bi bi-folder2-open me-1"></i> Project Detail
            </a>
            <a asp-action="Gantt" asp-route-projectId="@project?.Id" class="btn btn-outline-custom btn-sm px-3">
                <i class="bi bi-bar-chart-steps me-1"></i> Gantt
            </a>
            <a asp-action="Create" asp-route-projectId="@project?.Id" class="btn btn-gradient btn-sm px-3 shadow-sm">
                <i class="bi bi-plus-lg me-1"></i> New Task
            </a>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5 bg-white rounded-4 border shadow-sm my-4">
            <div class="avatar bg-primary-subtle text-primary mx-auto mb-3" style="width: 64px; height: 64px; font-size: 2rem;">
                <i class="bi bi-card-checklist"></i>
            </div>
            <h4 class="fw-bold text-dark">No Tasks Available</h4>
            <p class="text-secondary small mb-4">Start organizing your project work by adding your first task.</p>
            <a asp-action="Create" asp-route-projectId="@project?.Id" class="btn btn-gradient px-4 py-2 shadow">
                <i class="bi bi-plus-circle me-1"></i> Create First Task
            </a>
        </div>
    }
    else
    {
        <div id="kanbanBoard" class="kanban-board" data-project-id="@project?.Id">
            @foreach (var status in TaskStatusDisplay.AllStatuses)
            {
                var columnTasks = Model.Where(t => t.Status == status).ToList();

                <div class="kanban-column">
                    <div class="kanban-column-header">
                        <div class="d-flex align-items-center gap-2">
                            <span class="fw-bold">@TaskStatusDisplay.GetLabel(status)</span>
                            <span class="badge bg-white text-dark border rounded-circle column-count shadow-sm">@columnTasks.Count</span>
                        </div>
                        <a asp-action="Create" asp-route-projectId="@project?.Id" asp-route-status="@status" class="btn btn-sm btn-light text-muted p-1 rounded-circle" title="Add task to @status">
                            <i class="bi bi-plus-lg"></i>
                        </a>
                    </div>

                    <div class="kanban-column-body" data-status="@status">
                        @foreach (var task in columnTasks)
                        {
                            <div class="task-card" draggable="true" data-task-id="@task.Id" data-status="@task.Status" tabindex="0">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <h6 class="fw-bold text-dark mb-0 line-clamp-2">
                                        <a asp-action="Detail" asp-route-id="@task.Id" class="text-dark text-decoration-none hover-primary">@task.Title</a>
                                    </h6>
                                    
                                    <div class="dropdown">
                                        <button class="btn btn-sm btn-link text-muted p-0 border-0" type="button" data-bs-toggle="dropdown" aria-label="Task options">
                                            <i class="bi bi-three-dots-vertical"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-3">
                                            <li><h6 class="dropdown-header extra-small text-uppercase">Move to status</h6></li>
                                            @foreach (var target in TaskStatusDisplay.AllStatuses.Where(s => s != task.Status))
                                            {
                                                <li>
                                                    <button type="button" class="dropdown-item py-1 small move-task-btn" data-task-id="@task.Id" data-target-status="@target">
                                                        <i class="bi bi-arrow-right-short text-primary"></i> @TaskStatusDisplay.GetLabel(target)
                                                    </button>
                                                </li>
                                            }
                                            <li><hr class="dropdown-divider"></li>
                                            <li>
                                                <a class="dropdown-item py-1 small" asp-action="Edit" asp-route-id="@task.Id">
                                                    <i class="bi bi-pencil me-1"></i> Edit Details
                                                </a>
                                            </li>
                                        </ul>
                                    </div>
                                </div>

                                <div class="d-flex align-items-center gap-2 mb-3">
                                    <span class="badge-status priority-@task.Priority?.ToLower()">@task.Priority</span>
                                    
                                    @if (task.DueDate.HasValue)
                                    {
                                        <span class="extra-small text-muted bg-light px-2 py-1 rounded border">
                                            <i class="bi bi-calendar-event me-1"></i>@task.DueDate.Value.ToString("MMM dd")
                                        </span>
                                    }
                                </div>

                                <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                                    <div class="d-flex align-items-center gap-2 extra-small text-muted">
                                        <span title="Estimated & Actual Hours">
                                            <i class="bi bi-clock me-1 text-primary"></i>@(task.ActualHours ?? 0)/@(task.EstimatedHours ?? 0)h
                                        </span>
                                        <button type="button" class="timer-trigger" data-timer-task-id="@task.Id" data-timer-task-title="@task.Title" title="Start timer">
                                            <i class="bi bi-play-fill" data-timer-icon></i>
                                        </button>
                                    </div>

                                    @if (task.PrimaryAssigneeUserId.HasValue && !string.IsNullOrEmpty(task.PrimaryAssigneeName) && task.PrimaryAssigneeName != "Unassigned")
                                    {
                                        <div class="avatar avatar-sm" title="@task.PrimaryAssigneeName">
                                            @task.PrimaryAssigneeName.Substring(0, 1).ToUpper()
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="avatar avatar-sm" title="Unassigned">
                                            <i class="bi bi-person-fill"></i>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
    <script src="~/js/task-board.js" asp-append-version="true"></script>
    <script>
        document.getElementById('priorityFilter')?.addEventListener('change', function () {
            var url = new URL(window.location.href);
            if (this.value) {
                url.searchParams.set('priority', this.value);
            } else {
                url.searchParams.delete('priority');
            }
            window.location.href = url.toString();
        });
    </script>
}
