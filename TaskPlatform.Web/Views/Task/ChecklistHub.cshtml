@model List<TaskPlatform.Shared.ViewModels.Task.TaskViewModel>
@{
    ViewData["Title"] = "Checklist Hub";
    var projectLookup = ViewBag.ProjectLookup as Dictionary<Guid, TaskPlatform.Shared.ViewModels.Project.ProjectViewModel> ?? new();
    string? currentProjectId = ViewBag.CurrentProjectId as string;

    var taskChecklistMap = ViewBag.TaskChecklistMap as Dictionary<Guid, List<TaskPlatform.Shared.ViewModels.Task.ChecklistItemViewModel>> ?? new();
    var subtasksMap = ViewBag.SubtasksMap as Dictionary<Guid, List<TaskPlatform.Shared.ViewModels.Task.SubtaskViewModel>> ?? new();
    var subtaskChecklistMap = ViewBag.SubtaskChecklistMap as Dictionary<Guid, List<TaskPlatform.Shared.ViewModels.Task.ChecklistItemViewModel>> ?? new();

    int totalItems = 0;
    int completedItems = 0;

    foreach (var task in Model)
    {
        if (taskChecklistMap.TryGetValue(task.Id, out var items))
        {
            totalItems += items.Count;
            completedItems += items.Count(i => i.IsCompleted);
        }
        if (subtasksMap.TryGetValue(task.Id, out var subtasks))
        {
            foreach (var sub in subtasks)
            {
                if (subtaskChecklistMap.TryGetValue(sub.Id, out var subItems))
                {
                    totalItems += subItems.Count;
                    completedItems += subItems.Count(i => i.IsCompleted);
                }
            }
        }
    }

    int overallPct = totalItems > 0 ? (int)Math.Round(100.0 * completedItems / totalItems) : 0;
}

<div class="py-2">
    <!-- Header Controls -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3 pb-3 border-bottom">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <h3 class="fw-extrabold text-dark mb-0"><i class="bi bi-check2-square text-primary me-2"></i>Checklist Hub</h3>
                <span class="badge bg-primary-subtle text-primary rounded-pill px-3 fw-bold">@completedItems / @totalItems Items Completed (@overallPct%)</span>
            </div>
            <p class="text-secondary small mb-0">Task-wise and subtask-wise checklist breakdown across your projects.</p>
        </div>

        <div class="d-flex gap-2 align-items-center flex-wrap">
            <form method="get" asp-action="ChecklistHub" class="d-flex gap-2 align-items-center">
                <select name="projectId" class="form-select form-select-sm rounded-pill shadow-sm" style="min-width: 200px;" onchange="this.form.submit()">
                    <option value="">All Projects</option>
                    @foreach (var proj in projectLookup.Values)
                    {
                        <option value="@proj.Id" selected="@(currentProjectId == proj.Id.ToString())">@proj.Name</option>
                    }
                </select>
            </form>
        </div>
    </div>

    <!-- Progress Card Summary -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 bg-gradient-subtle">
        <div class="card-body p-4">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="fw-bold text-dark"><i class="bi bi-bar-chart-line-fill text-primary me-2"></i>Overall Checklist Progress</span>
                <span class="fw-extrabold text-primary">@overallPct%</span>
            </div>
            <div class="progress rounded-pill shadow-inner" style="height: 10px;">
                <div class="progress-bar progress-bar-gradient rounded-pill" role="progressbar" style="width: @overallPct%;" aria-valuenow="@overallPct" aria-valuemin="0" aria-valuemax="100"></div>
            </div>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5 bg-white rounded-4 border shadow-sm my-4">
            <div class="avatar bg-primary-subtle text-primary mx-auto mb-3" style="width: 64px; height: 64px; font-size: 2rem;">
                <i class="bi bi-check2-all"></i>
            </div>
            <h4 class="fw-bold text-dark">No Tasks Found</h4>
            <p class="text-secondary small mb-4">Create tasks with checklist items to manage checklist execution here.</p>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var task in Model)
            {
                var taskItems = taskChecklistMap.TryGetValue(task.Id, out var ti) ? ti : new();
                var subtasks = subtasksMap.TryGetValue(task.Id, out var st) ? st : new();
                var taskDone = taskItems.Count(i => i.IsCompleted);
                var proj = projectLookup.ContainsKey(task.ProjectId) ? projectLookup[task.ProjectId] : null;

                <div class="col-12 col-xl-6">
                    <div class="card border-0 shadow-sm rounded-4 h-100 task-checklist-card">
                        <div class="card-header bg-white border-bottom p-3 d-flex justify-content-between align-items-center">
                            <div>
                                <div class="d-flex align-items-center gap-2 mb-1">
                                    <span class="badge bg-light text-secondary border rounded-pill extra-small">@proj?.Name</span>
                                    <span class="badge bg-primary-subtle text-primary rounded-pill extra-small">@task.Status</span>
                                </div>
                                <h5 class="fw-bold text-dark mb-0">
                                    <a asp-action="Detail" asp-route-id="@task.Id" class="text-dark text-decoration-none hover-primary">@task.Title</a>
                                </h5>
                            </div>
                            <a asp-action="Detail" asp-route-id="@task.Id" class="btn btn-sm btn-outline-custom rounded-circle" title="View Detail">
                                <i class="bi bi-arrow-right"></i>
                            </a>
                        </div>

                        <div class="card-body p-3">
                            <!-- Parent Task Checklist -->
                            <div class="mb-3">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="small font-bold text-dark"><i class="bi bi-list-check me-1 text-primary"></i>Task Checklist</span>
                                    <span class="small font-semibold text-muted">@taskDone / @taskItems.Count</span>
                                </div>
                                @if (taskItems.Any())
                                {
                                    <div class="list-group list-group-flush rounded-3 border">
                                        @foreach (var item in taskItems)
                                        {
                                            <div class="list-group-item d-flex justify-content-between align-items-center p-2 small checklist-item" data-item-id="@item.Id">
                                                <div class="form-check mb-0">
                                                    <input class="form-check-input checklist-toggle" type="checkbox" data-item-id="@item.Id" id="hub-chk-@item.Id" @(item.IsCompleted ? "checked" : "") />
                                                    <label class="form-check-label @(item.IsCompleted ? "text-decoration-line-through text-muted" : "text-dark")" for="hub-chk-@item.Id">
                                                        @item.Title
                                                    </label>
                                                </div>
                                                <button type="button" class="btn btn-sm btn-link text-danger p-0 checklist-delete" data-item-id="@item.Id" title="Delete item">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="p-2 bg-light rounded text-muted extra-small">No direct checklist items on parent task.</div>
                                }
                            </div>

                            <!-- Subtasks Checklists -->
                            @if (subtasks.Any())
                            {
                                <div class="border-top pt-2">
                                    <span class="extra-small font-bold text-uppercase tracking-wider text-muted mb-2 d-block">Subtask Checklists (@subtasks.Count)</span>
                                    @foreach (var sub in subtasks)
                                    {
                                        var subItems = subtaskChecklistMap.TryGetValue(sub.Id, out var si) ? si : new();
                                        var subDone = subItems.Count(i => i.IsCompleted);

                                        <div class="bg-light rounded-3 p-2 mb-2">
                                            <div class="d-flex justify-content-between align-items-center mb-1">
                                                <span class="small fw-bold text-dark"><i class="bi bi-diagram-2 text-info me-1"></i>@sub.Title</span>
                                                <span class="extra-small text-muted">@subDone / @subItems.Count</span>
                                            </div>
                                            @if (subItems.Any())
                                            {
                                                <div class="list-group list-group-flush rounded border bg-white">
                                                    @foreach (var sItem in subItems)
                                                    {
                                                        <div class="list-group-item d-flex justify-content-between align-items-center p-2 extra-small checklist-item" data-item-id="@sItem.Id">
                                                            <div class="form-check mb-0">
                                                                <input class="form-check-input checklist-toggle" type="checkbox" data-item-id="@sItem.Id" id="hub-subchk-@sItem.Id" @(sItem.IsCompleted ? "checked" : "") />
                                                                <label class="form-check-label @(sItem.IsCompleted ? "text-decoration-line-through text-muted" : "text-dark")" for="hub-subchk-@sItem.Id">
                                                                    @sItem.Title
                                                                </label>
                                                            </div>
                                                            <button type="button" class="btn btn-sm btn-link text-danger p-0 checklist-delete" data-item-id="@sItem.Id" title="Delete item">
                                                                <i class="bi bi-trash"></i>
                                                            </button>
                                                        </div>
                                                    }
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="extra-small text-muted italic">No checklist items for this subtask.</span>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
    <script>
        document.addEventListener('click', function(e) {
            var toggle = e.target.closest('.checklist-toggle');
            if (toggle) {
                var itemId = toggle.getAttribute('data-item-id');
                fetch('/Task/ToggleChecklistItemAjax/' + itemId, { method: 'POST', headers: { 'X-CSRF-TOKEN': document.querySelector('meta[name="request-verification-token"]')?.getAttribute('content') || '' } })
                    .then(r => r.json())
                    .then(res => {
                        if (res.success) {
                            window.location.reload();
                        } else {
                            showToast(res.message || 'Error toggling checklist item', 'danger');
                        }
                    });
            }
            var del = e.target.closest('.checklist-delete');
            if (del) {
                var itemId = del.getAttribute('data-item-id');
                if (confirm('Are you sure you want to delete this checklist item?')) {
                    fetch('/Task/DeleteChecklistItemAjax/' + itemId, { method: 'POST', headers: { 'X-CSRF-TOKEN': document.querySelector('meta[name="request-verification-token"]')?.getAttribute('content') || '' } })
                        .then(r => r.json())
                        .then(res => {
                            if (res.success) {
                                window.location.reload();
                            } else {
                                showToast(res.message || 'Error deleting checklist item', 'danger');
                            }
                        });
                }
            }
        });
    </script>
}
