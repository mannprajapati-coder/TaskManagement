@model TaskPlatform.Shared.ViewModels.Task.TaskViewModel
@using TaskPlatform.Shared.ViewModels.Collaboration
@using TaskPlatform.Shared.ViewModels.Project
@using TaskPlatform.Shared.ViewModels.TimeTracking
@{
    ViewData["Title"] = Model.Title;
    var timeLogs = ViewBag.TimeLogs as List<TimeLogViewModel> ?? new List<TimeLogViewModel>();
    var subtasks = ViewBag.Subtasks as List<TaskPlatform.Shared.ViewModels.Task.SubtaskViewModel> ?? new List<TaskPlatform.Shared.ViewModels.Task.SubtaskViewModel>();
    var assignees = ViewBag.Assignees as List<TaskPlatform.Shared.ViewModels.Task.TaskAssigneeViewModel> ?? new List<TaskPlatform.Shared.ViewModels.Task.TaskAssigneeViewModel>();
    var watchers = ViewBag.Watchers as List<TaskPlatform.Shared.ViewModels.Task.TaskWatcherViewModel> ?? new List<TaskPlatform.Shared.ViewModels.Task.TaskWatcherViewModel>();
    var checklistItems = ViewBag.ChecklistItems as List<TaskPlatform.Shared.ViewModels.Task.ChecklistItemViewModel> ?? new List<TaskPlatform.Shared.ViewModels.Task.ChecklistItemViewModel>();
    var recurringRule = ViewBag.RecurringRule as TaskPlatform.Shared.ViewModels.Task.RecurringTaskRuleViewModel;
    var comments = ViewBag.Comments as List<CommentViewModel> ?? new List<CommentViewModel>();
    var attachments = ViewBag.Attachments as List<AttachmentViewModel> ?? new List<AttachmentViewModel>();
    var projectMembers = ViewBag.ProjectMembers as List<ProjectMemberViewModel> ?? new List<ProjectMemberViewModel>();
    var activityLogs = ViewBag.ActivityLogs as List<TaskPlatform.Shared.ViewModels.Notification.ActivityLogViewModel> ?? new List<TaskPlatform.Shared.ViewModels.Notification.ActivityLogViewModel>();
    var unassignedMembers = projectMembers.Where(m => !assignees.Any(a => a.UserId == m.UserId)).ToList();
    var currentUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? string.Empty;
    var checklistDone = checklistItems.Count(c => c.IsCompleted);
    var checklistPct = checklistItems.Count > 0 ? (int)Math.Round(100.0 * checklistDone / checklistItems.Count) : 0;
    var canModify = ViewBag.CanModify as bool? ?? false;
    var pendingSubtasks = subtasks.Count(st => st.Status != "Completed" && st.Status != "Cancelled");
    var subtaskTitleLookup = ViewBag.SubtaskTitleLookup as Dictionary<Guid, string> ?? new Dictionary<Guid, string>();
    var subtaskProgress = ViewBag.SubtaskProgress as Dictionary<Guid, (int Done, int Total)> ?? new Dictionary<Guid, (int Done, int Total)>();

    string ActorName(Guid actorUserId, string fallback)
    {
        var member = projectMembers.FirstOrDefault(m => m.UserId == actorUserId);
        return member?.FullName ?? (string.IsNullOrEmpty(fallback) || fallback == "User" ? "A team member" : fallback);
    }

    string ActivityIcon(string action) => action switch
    {
        "TaskCreated" => "bi-plus-circle text-success",
        "TaskUpdated" => "bi-pencil-square text-primary",
        "StatusChanged" => "bi-arrow-repeat text-warning",
        "TaskDeleted" => "bi-trash text-danger",
        "SubtaskCreated" => "bi-diagram-2 text-info",
        "AssigneeAdded" => "bi-person-plus text-primary",
        "AssigneeRemoved" => "bi-person-dash text-danger",
        "ChecklistItemAdded" => "bi-check2-square text-success",
        "RecurringRuleSet" => "bi-arrow-repeat text-info",
        "CommentAdded" => "bi-chat-dots text-primary",
        "AttachmentAdded" => "bi-paperclip text-secondary",
        _ => "bi-clock-history text-muted"
    };
}

<div class="py-2">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <!-- Header Metadata Card -->
            <div class="card border-0 shadow-sm rounded-4 mb-4 bg-white">
                <div class="card-body p-4 p-md-5">
                    <div class="d-flex flex-wrap justify-content-between align-items-start mb-3 gap-3">
                        <div>
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <span class="badge-status priority-@Model.Priority?.ToLower()">@Model.Priority Priority</span>
                                <span class="badge-status badge-@Model.Status?.ToLower()">@TaskStatusDisplay.GetLabel(Model.Status)</span>
                            </div>
                            <h2 class="fw-extrabold text-dark mb-1">@Model.Title</h2>
                            <div class="extra-small text-muted">
                                <i class="bi bi-clock me-1"></i>Created @Model.CreatedAt.ToString("MMM dd, yyyy HH:mm")
                            </div>
                        </div>

                        <div class="d-flex gap-2 align-items-center flex-wrap">
                            @if (canModify)
                            {
                                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-custom rounded-pill px-3">
                                    <i class="bi bi-pencil me-1"></i> Edit Task
                                </a>
                            }
                            <button type="button" class="btn btn-sm btn-gradient rounded-pill px-3" data-timer-task-id="@Model.Id" data-timer-task-title="@Model.Title" title="Start timer">
                                <i class="bi bi-play-fill me-1" data-timer-icon></i><span data-timer-label>Start</span> Timer
                            </button>
                            <form asp-action="ToggleWatcher" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@Model.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-custom rounded-pill px-3" title="Watch Task">
                                    <i class="bi bi-eye text-warning me-1"></i> Watch (@watchers.Count)
                                </button>
                            </form>
                            <a asp-action="Index" asp-route-projectId="@Model.ProjectId" class="btn btn-sm btn-outline-custom rounded-pill px-3">
                                <i class="bi bi-arrow-left me-1"></i> Task Board
                            </a>
                        </div>
                    </div>

                    <p class="text-secondary lead fs-6 mb-4">@(string.IsNullOrEmpty(Model.Description) ? "No detailed description provided." : Model.Description)</p>

                    <hr class="my-4 text-muted opacity-25" />

                    <!-- Quick Metrics Grid -->
                    <div class="row text-center g-3 mb-4">
                        <div class="col-6 col-md-3">
                            <div class="p-3 bg-light rounded-3">
                                <span class="extra-small text-muted d-block font-semibold">Status</span>
                                <strong class="text-dark fs-6" id="statusDisplay">
                                    @TaskStatusDisplay.GetLabel(Model.Status)
                                </strong>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="p-3 bg-light rounded-3">
                                <span class="extra-small text-muted d-block font-semibold">Due Date</span>
                                <strong class="text-dark fs-6">@(Model.DueDate?.ToString("MMM dd, yyyy") ?? "Not Set")</strong>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="p-3 bg-light rounded-3">
                                <span class="extra-small text-muted d-block font-semibold">Est. Hours</span>
                                <strong class="text-dark fs-6">@(Model.EstimatedHours ?? 0) hrs</strong>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="p-3 bg-light rounded-3">
                                <span class="extra-small text-muted d-block font-semibold">Actual Hours</span>
                                <strong class="text-dark fs-6">@(Model.ActualHours ?? 0) hrs</strong>
                            </div>
                        </div>
                    </div>

                    <!-- Update Status Bar -->
                    @if (canModify)
                    {
                        <div class="bg-light p-3 rounded-4 border d-flex flex-wrap align-items-center justify-content-between gap-3">
                            <div class="d-flex align-items-center gap-2">
                                <label for="statusSelect" class="small fw-bold text-dark mb-0">Change Task Status:</label>
                                <form id="statusForm" asp-action="UpdateStatus" method="post" class="d-flex gap-2 align-items-center task-status-form">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="TaskId" value="@Model.Id" />
                                    <input type="hidden" name="projectId" value="@Model.ProjectId" />

                                    <select name="Status" id="statusSelect" class="form-select form-select-sm rounded-pill shadow-xs" style="min-width: 180px;">
                                        <option value="Todo" selected="@(Model.Status == "Todo")">Todo</option>
                                        <option value="InProgress" selected="@(Model.Status == "InProgress")">In Progress</option>
                                        <option value="InReview" selected="@(Model.Status == "InReview")">In Review</option>
                                        <option value="Completed" selected="@(Model.Status == "Completed")">Completed</option>
                                        <option value="Cancelled" selected="@(Model.Status == "Cancelled")">Cancelled</option>
                                    </select>
                                    <button type="submit" class="btn btn-sm btn-gradient rounded-pill px-3 shadow-xs">Apply</button>
                                </form>
                            </div>

                            <form asp-action="Delete" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@Model.Id" />
                                <input type="hidden" name="projectId" value="@Model.ProjectId" />
                                <button type="submit" onclick="return confirm('Delete this task and all its subtasks?')" class="btn btn-outline-danger btn-sm rounded-pill px-3">
                                    <i class="bi bi-trash me-1"></i> Delete Task
                                </button>
                            </form>
                        </div>
                    }
                </div>
            </div>

            <!-- Subtasks Section -->
            <div class="card border-0 shadow-sm rounded-4 mb-4 bg-white">
                <div class="card-body p-4 p-md-5">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="fw-bold text-dark mb-0">
                            <i class="bi bi-diagram-2-fill text-primary me-2"></i>Linked Subtasks (@subtasks.Count)
                        </h5>

                        @if (pendingSubtasks > 0)
                        {
                            <span class="badge bg-warning-subtle text-warning border border-warning-subtle rounded-pill small">
                                <i class="bi bi-exclamation-circle me-1"></i> @pendingSubtasks Pending Subtask(s)
                            </span>
                        }
                        else if (subtasks.Any())
                        {
                            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill small">
                                <i class="bi bi-check-circle-fill me-1"></i> All Subtasks Completed
                            </span>
                        }
                    </div>

                    @if (pendingSubtasks > 0)
                    {
                        <div class="alert alert-warning small p-3 rounded-3 mb-3 border-0 shadow-xs">
                            <i class="bi bi-info-circle-fill me-2"></i>
                            <strong>Note:</strong> All subtasks must be completed before marking this parent task as <strong>Completed</strong>.
                        </div>
                    }

                    @if (subtasks.Any())
                    {
                        <div class="mb-4">
                            @foreach (var st in subtasks)
                            {
                                var progress = subtaskProgress.TryGetValue(st.Id, out var p) ? p : (Done: 0, Total: 0);
                                var isDone = st.Status == "Completed" || st.Status == "Cancelled";
                                <div class="border rounded-3 mb-2 overflow-hidden subtask-item">
                                    <div class="d-flex align-items-center">
                                        <button class="flex-grow-1 d-flex justify-content-between align-items-center p-3 bg-transparent border-0 text-start subtask-toggle"
                                                type="button" data-bs-toggle="collapse" data-bs-target="#subtask-@st.Id"
                                                data-subtask-id="@st.Id" data-project-id="@st.ProjectId">
                                            <span class="d-flex align-items-center gap-2">
                                                <i class="bi @(st.Status == "Completed" ? "bi-check-circle-fill text-success" : "bi-circle text-muted") fs-5"></i>
                                                <span class="fw-bold @(st.Status == "Completed" ? "text-decoration-line-through text-muted" : "text-dark")">@st.Title</span>
                                            </span>
                                            <span class="d-flex align-items-center gap-2">
                                                @if (st.DueDate.HasValue)
                                                {
                                                    <span class="extra-small text-muted bg-light px-2 py-1 rounded border">
                                                        <i class="bi bi-calendar-event me-1"></i>@st.DueDate.Value.ToString("MMM dd")
                                                    </span>
                                                }
                                                @if (progress.Total > 0)
                                                {
                                                    <span class="extra-small text-muted bg-light px-2 py-1 rounded border">
                                                        <i class="bi bi-check2-square me-1"></i>@progress.Done/@progress.Total
                                                    </span>
                                                }
                                                <span class="badge-status badge-@st.Status?.ToLower()">@TaskStatusDisplay.GetLabel(st.Status)</span>
                                                <i class="bi bi-chevron-down small text-muted"></i>
                                            </span>
                                        </button>
                                        @if (canModify)
                                        {
                                            <div class="d-flex align-items-center gap-1 pe-2">
                                                @if (!isDone)
                                                {
                                                    <button type="button" class="btn btn-sm btn-link text-success p-1 subtask-quick-complete" data-subtask-id="@st.Id" title="Mark Complete">
                                                        <i class="bi bi-check-circle fs-5"></i>
                                                    </button>
                                                }
                                                <button type="button" class="btn btn-sm btn-link text-danger p-1 subtask-quick-delete" data-subtask-id="@st.Id" title="Delete Subtask">
                                                    <i class="bi bi-trash fs-6"></i>
                                                </button>
                                            </div>
                                        }
                                    </div>
                                    <div id="subtask-@st.Id" class="collapse">
                                        <div class="p-3 border-top bg-light subtask-panel-container" data-subtask-id="@st.Id">
                                            <div class="text-muted small py-2"><i class="bi bi-hourglass-split me-1"></i>Loading...</div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4 text-muted bg-light rounded-3 mb-3">
                            <p class="small mb-0">No subtasks created for this task yet.</p>
                        </div>
                    }

                    @if (canModify)
                    {
                        <form asp-action="CreateSubtask" method="post" class="mt-2">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="ParentTaskId" value="@Model.Id" />
                            <input type="hidden" name="ProjectId" value="@Model.ProjectId" />
                            <div class="row g-2 align-items-end">
                                <div class="col-12 col-md-4">
                                    <label class="form-label extra-small text-muted mb-1">Title</label>
                                    <input type="text" name="Title" class="form-control" placeholder="Add a new subtask..." required />
                                </div>
                                <div class="col-6 col-md-2">
                                    <label class="form-label extra-small text-muted mb-1">Priority</label>
                                    <select name="Priority" class="form-select">
                                        <option value="Low">Low</option>
                                        <option value="Medium" selected>Medium</option>
                                        <option value="High">High</option>
                                        <option value="Urgent">Urgent</option>
                                    </select>
                                </div>
                                <div class="col-6 col-md-2">
                                    <label class="form-label extra-small text-muted mb-1">Due Date</label>
                                    <input type="date" name="DueDate" class="form-control" />
                                </div>
                                <div class="col-8 col-md-3">
                                    <label class="form-label extra-small text-muted mb-1">Assign To</label>
                                    <select name="PrimaryAssigneeUserId" class="form-select">
                                        <option value="">Unassigned</option>
                                        @foreach (var m in projectMembers)
                                        {
                                            <option value="@m.UserId">@m.FullName</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-4 col-md-1">
                                    <button type="submit" class="btn btn-gradient w-100 font-semibold" title="Add Subtask"><i class="bi bi-plus-lg"></i></button>
                                </div>
                            </div>
                        </form>
                    }
                </div>
            </div>

            <!-- Tabbed Collaboration Widgets -->
            <div class="card border-0 shadow-sm rounded-4 mb-4 bg-white">
                <div class="card-body p-4 p-md-5">
                    <ul class="nav nav-pills gap-2 mb-4 border-bottom pb-3" id="taskWidgetTabs" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active rounded-pill fw-bold px-3" data-bs-toggle="pill" data-bs-target="#tab-checklist" type="button" role="tab">
                                <i class="bi bi-check2-square me-1"></i> Checklist
                                <span id="checklistCountBadge" class="badge bg-white text-dark border rounded-circle ms-1">@checklistDone/@checklistItems.Count</span>
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link rounded-pill fw-bold px-3" data-bs-toggle="pill" data-bs-target="#tab-assignees" type="button" role="tab">
                                <i class="bi bi-people me-1"></i> Assignees (@assignees.Count)
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link rounded-pill fw-bold px-3" data-bs-toggle="pill" data-bs-target="#tab-comments" type="button" role="tab">
                                <i class="bi bi-chat-dots me-1"></i> Comments (@comments.Count)
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link rounded-pill fw-bold px-3" data-bs-toggle="pill" data-bs-target="#tab-attachments" type="button" role="tab">
                                <i class="bi bi-paperclip me-1"></i> Attachments (@attachments.Count)
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link rounded-pill fw-bold px-3" data-bs-toggle="pill" data-bs-target="#tab-activity" type="button" role="tab">
                                <i class="bi bi-clock-history me-1"></i> Activity (@activityLogs.Count)
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link rounded-pill fw-bold px-3" data-bs-toggle="pill" data-bs-target="#tab-timelog" type="button" role="tab">
                                <i class="bi bi-stopwatch me-1"></i> Time Log (@timeLogs.Count)
                            </button>
                        </li>
                    </ul>

                    <div class="tab-content">
                        <!-- Checklist Tab -->
                        <div class="tab-pane fade show active" id="tab-checklist" role="tabpanel">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="small font-semibold text-secondary">Checklist Completion Rate</span>
                                <span id="checklistPctText" class="small font-bold text-primary">@checklistPct% Done</span>
                            </div>
                            <div class="progress progress-sm rounded-pill mb-4">
                                <div class="progress-bar progress-bar-gradient" role="progressbar" style="width: @checklistPct%;" aria-valuenow="@checklistPct" aria-valuemin="0" aria-valuemax="100"></div>
                            </div>
                            
                            @if (checklistItems.Any())
                            {
                                <div class="list-group list-group-flush mb-4 border rounded-3 overflow-hidden">
                                    @foreach (var item in checklistItems)
                                    {
                                        <div class="list-group-item d-flex justify-content-between align-items-center p-3 bg-transparent border-bottom checklist-item" data-item-id="@item.Id">
                                            <div class="form-check">
                                                <input class="form-check-input checklist-toggle" type="checkbox" data-item-id="@item.Id" id="chk-@item.Id" @(item.IsCompleted ? "checked" : "") disabled="@(!canModify)" />
                                                <label class="form-check-label fw-medium @(item.IsCompleted ? "text-decoration-line-through text-muted" : "text-dark")" for="chk-@item.Id">@item.Title</label>
                                            </div>
                                            @if (canModify)
                                            {
                                                <button type="button" class="btn btn-sm btn-link text-danger p-0 checklist-delete" data-item-id="@item.Id" title="Delete item"><i class="bi bi-trash"></i></button>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="text-center py-4 text-muted bg-light rounded-3 mb-3">
                                    <p class="small mb-0">No checklist items added yet.</p>
                                </div>
                            }

                            @if (canModify)
                            {
                                <form asp-action="AddChecklistItem" method="post" class="mt-2">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="TaskId" value="@Model.Id" />
                                    <div class="input-group">
                                        <input type="text" name="Title" class="form-control" placeholder="Add a checklist item..." required maxlength="200" />
                                        <button type="submit" class="btn btn-gradient px-4 font-semibold"><i class="bi bi-plus-lg me-1"></i> Add Item</button>
                                    </div>
                                </form>
                            }
                        </div>

                        <!-- Assignees Tab -->
                        <div class="tab-pane fade" id="tab-assignees" role="tabpanel">
                            @if (assignees.Any())
                            {
                                <div class="list-group list-group-flush mb-4 border rounded-3 overflow-hidden">
                                    @foreach (var a in assignees)
                                    {
                                        <div class="list-group-item d-flex justify-content-between align-items-center p-3 bg-transparent border-bottom">
                                            <div class="d-flex align-items-center gap-3">
                                                <div class="avatar avatar-sm">@(a.FullName.Substring(0, 1).ToUpper())</div>
                                                <div>
                                                    <h6 class="fw-bold text-dark mb-0">@a.FullName</h6>
                                                    <span class="extra-small text-muted">@a.Email</span>
                                                </div>
                                            </div>
                                            <div class="d-flex align-items-center gap-2">
                                                @if (a.IsPrimary)
                                                {
                                                    <span class="badge bg-primary-subtle text-primary rounded-pill px-3">Primary Assignee</span>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="text-center py-4 text-muted bg-light rounded-3 mb-3">
                                    <p class="small mb-0">No assignees assigned to this task yet.</p>
                                </div>
                            }
                        </div>

                        <!-- Comments Tab -->
                        <div class="tab-pane fade" id="tab-comments" role="tabpanel">
                            @if (comments.Any())
                            {
                                <div class="mb-4" style="max-height: 360px; overflow-y: auto;">
                                    @foreach (var c in comments)
                                    {
                                        <div class="d-flex gap-3 border-bottom py-3">
                                            <div class="avatar avatar-sm">@(c.AuthorName?.Substring(0, 1).ToUpper() ?? "U")</div>
                                            <div class="flex-grow-1">
                                                <div class="d-flex justify-content-between align-items-center">
                                                    <h6 class="fw-bold text-dark mb-0">@c.AuthorName</h6>
                                                    <span class="extra-small text-muted">@c.CreatedAt.ToString("MMM dd, yyyy HH:mm")</span>
                                                </div>
                                                <p class="text-secondary small mb-0 mt-1">@c.CommentText</p>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }

                            <form asp-action="AddComment" method="post" class="mt-2">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="TaskId" value="@Model.Id" />
                                <textarea name="CommentText" class="form-control mb-3" rows="3" maxlength="2000" placeholder="Write a comment..." required></textarea>
                                <button type="submit" class="btn btn-gradient px-4 font-semibold">Post Comment</button>
                            </form>
                        </div>

                        <!-- Attachments Tab -->
                        <div class="tab-pane fade" id="tab-attachments" role="tabpanel">
                            <form asp-action="UploadAttachment" method="post" enctype="multipart/form-data" class="mb-4">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="taskId" value="@Model.Id" />
                                <label id="attachmentDropzone" for="attachmentFileInput" class="d-block text-center border border-2 border-dashed rounded-4 p-4 text-muted bg-light" style="cursor: pointer;">
                                    <i class="bi bi-cloud-arrow-up display-5 text-primary d-block mb-2"></i>
                                    <span class="fw-bold text-dark d-block">Upload File Attachment</span>
                                    <span id="attachmentFileName" class="extra-small text-muted">Click or drag file here (max 25 MB)</span>
                                    <input type="file" name="file" id="attachmentFileInput" class="d-none" onchange="this.form.submit()" />
                                </label>
                            </form>

                            @if (attachments.Any())
                            {
                                <div class="list-group list-group-flush rounded-4 border overflow-hidden">
                                    @foreach (var att in attachments)
                                    {
                                        var isImage = att.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase);
                                        var isPdf = att.ContentType.Equals("application/pdf", StringComparison.OrdinalIgnoreCase);
                                        var sizeKb = Math.Round(att.FileSize / 1024.0, 1);

                                        <div class="list-group-item d-flex justify-content-between align-items-center p-3">
                                            <div class="d-flex align-items-center gap-3">
                                                <div class="avatar bg-primary-subtle text-primary rounded-3 flex-shrink-0" style="width: 42px; height: 42px; font-size: 1.25rem;">
                                                    @if (isImage) { <i class="bi bi-file-earmark-image-fill"></i> }
                                                    else if (isPdf) { <i class="bi bi-file-earmark-pdf-fill text-danger"></i> }
                                                    else { <i class="bi bi-file-earmark-arrow-down-fill"></i> }
                                                </div>
                                                <div>
                                                    <h6 class="fw-bold text-dark mb-0">@att.FileName</h6>
                                                    <span class="extra-small text-muted">@sizeKb KB &bull; Uploaded @att.UploadedAt.ToString("MMM dd, yyyy HH:mm")</span>
                                                </div>
                                            </div>

                                            <div class="d-flex align-items-center gap-2">
                                                <button type="button" class="btn btn-sm btn-outline-custom rounded-pill px-3 preview-attachment-btn" data-url="@Url.Action("PreviewAttachment", "Task", new { id = att.Id, taskId = Model.Id })" data-title="@att.FileName" data-type="@att.ContentType">
                                                    <i class="bi bi-eye me-1"></i> Preview
                                                </button>
                                                <a asp-action="DownloadAttachment" asp-route-id="@att.Id" asp-route-taskId="@Model.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                                    <i class="bi bi-download me-1"></i> Download
                                                </a>
                                                <form asp-action="DeleteAttachment" method="post" class="d-inline" onsubmit="return confirm('Delete this attachment?');">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@att.Id" />
                                                    <input type="hidden" name="taskId" value="@Model.Id" />
                                                    <button type="submit" class="btn btn-sm btn-link text-danger p-1" title="Delete">
                                                        <i class="bi bi-trash fs-5"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="text-center py-4 text-muted bg-light rounded-4">
                                    <p class="small mb-0">No attachments uploaded yet.</p>
                                </div>
                            }
                        </div>

                        <!-- Activity Tab -->
                        <div class="tab-pane fade" id="tab-activity" role="tabpanel">
                            @if (activityLogs.Any())
                            {
                                <ul class="list-unstyled mb-0" style="max-height: 420px; overflow-y: auto;">
                                    @foreach (var log in activityLogs)
                                    {
                                        var fromSubtask = log.TaskId.HasValue && log.TaskId.Value != Model.Id && subtaskTitleLookup.ContainsKey(log.TaskId.Value);
                                        <li class="d-flex gap-3 pb-3">
                                            <div class="flex-shrink-0">
                                                <i class="bi @ActivityIcon(log.Action) fs-5"></i>
                                            </div>
                                            <div class="flex-grow-1 border-bottom pb-3">
                                                <div>
                                                    <span class="fw-bold text-dark">@ActorName(log.ActorUserId, log.ActorName)</span>
                                                    <span class="text-secondary">@log.Details</span>
                                                    @if (fromSubtask)
                                                    {
                                                        <span class="badge bg-light text-dark border rounded-pill ms-1 small">via subtask: @subtaskTitleLookup[log.TaskId!.Value]</span>
                                                    }
                                                </div>
                                                <span class="extra-small text-muted">@log.Timestamp.ToString("MMM dd, yyyy HH:mm")</span>
                                            </div>
                                        </li>
                                    }
                                </ul>
                            }
                            else
                            {
                                <div class="text-center py-4 text-muted bg-light rounded-3 mb-3">
                                    <p class="small mb-0">No activity recorded for this task yet.</p>
                                </div>
                            }
                        </div>

                        <!-- Time Log Tab -->
                        <div class="tab-pane fade" id="tab-timelog" role="tabpanel">
                            @if (timeLogs.Any())
                            {
                                <div class="table-responsive">
                                    <table class="table table-hover align-middle mb-0">
                                        <thead class="bg-light border-bottom">
                                            <tr class="text-secondary small fw-bold">
                                                <th class="py-2">TEAM MEMBER</th>
                                                <th class="py-2">DATE</th>
                                                <th class="py-2">DURATION</th>
                                                <th class="py-2">NOTES</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var log in timeLogs)
                                            {
                                                <tr>
                                                    <td class="py-2 fw-semibold text-dark">@log.UserName</td>
                                                    <td class="py-2 small text-secondary">@log.StartedAt.ToString("MMM dd, yyyy HH:mm")</td>
                                                    <td class="py-2 fw-semibold">@(log.DurationMinutes.HasValue ? $"{log.DurationMinutes / 60}h {log.DurationMinutes % 60}m" : "Running")</td>
                                                    <td class="py-2 small text-secondary">@(string.IsNullOrWhiteSpace(log.Notes) ? "—" : log.Notes)</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="text-center py-4 text-muted bg-light rounded-3 mb-3">
                                    <p class="small mb-0">No time has been logged on this task yet.</p>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/task-detail.js" asp-append-version="true"></script>
}
