@model TaskPlatform.Shared.ViewModels.Auth.RegisterRequestViewModel
@{
    ViewData["Title"] = "Sign Up";
}

<div class="auth-wrapper">
    <div class="auth-card">
        <div class="text-center mb-4">
            <h3 class="fw-bold text-dark mb-1">Create Account</h3>
            <p class="text-muted small">Start managing your team's workflow today</p>
        </div>

        <form asp-action="Register" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

            <div class="mb-3">
                <label asp-for="FullName" class="form-label small fw-semibold">Full Name</label>
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0"><i class="bi bi-person text-muted"></i></span>
                    <input asp-for="FullName" class="form-control border-start-0" placeholder="John Doe" autocomplete="name" />
                </div>
                <span asp-validation-for="FullName" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label small fw-semibold">Email Address</label>
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0"><i class="bi bi-envelope text-muted"></i></span>
                    <input asp-for="Email" class="form-control border-start-0" placeholder="name@company.com" autocomplete="email" />
                </div>
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label small fw-semibold">Password</label>
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0"><i class="bi bi-lock text-muted"></i></span>
                    <input asp-for="Password" type="password" class="form-control border-start-0" placeholder="••••••••" autocomplete="new-password" />
                </div>
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ConfirmPassword" class="form-label small fw-semibold">Confirm Password</label>
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0"><i class="bi bi-check2-circle text-muted"></i></span>
                    <input asp-for="ConfirmPassword" type="password" class="form-control border-start-0" placeholder="••••••••" autocomplete="new-password" />
                </div>
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-gradient w-100 mb-3 shadow-sm">
                Create Account <i class="bi bi-check-lg ms-1"></i>
            </button>
        </form>

        <p class="text-center text-muted small mb-0">
            Already have an account? <a asp-action="Login" class="text-primary fw-semibold text-decoration-none">Log in</a>
        </p>
    </div>
</div>
