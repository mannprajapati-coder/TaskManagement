@model TaskPlatform.Shared.ViewModels.Auth.ResetPasswordRequestViewModel
@{
    ViewData["Title"] = "Set New Password";
}

<div class="auth-wrapper">
    <div class="auth-card">
        <div class="text-center mb-4">
            <h3 class="fw-bold text-dark mb-1">Set New Password</h3>
            <p class="text-muted small">Choose a strong password for your account</p>
        </div>

        <form asp-action="ResetPassword" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="UserId" />
            <input type="hidden" asp-for="Token" />

            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

            <div class="mb-3">
                <label asp-for="NewPassword" class="form-label small fw-semibold">New Password</label>
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0"><i class="bi bi-lock text-muted"></i></span>
                    <input asp-for="NewPassword" type="password" class="form-control border-start-0" placeholder="••••••••" />
                </div>
                <span asp-validation-for="NewPassword" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ConfirmPassword" class="form-label small fw-semibold">Confirm New Password</label>
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0"><i class="bi bi-check2-circle text-muted"></i></span>
                    <input asp-for="ConfirmPassword" type="password" class="form-control border-start-0" placeholder="••••••••" />
                </div>
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-gradient w-100 mb-3 shadow-sm">
                Reset Password <i class="bi bi-arrow-right ms-1"></i>
            </button>
        </form>
    </div>
</div>
