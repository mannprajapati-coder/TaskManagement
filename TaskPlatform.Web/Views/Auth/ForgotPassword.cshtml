@model TaskPlatform.Shared.ViewModels.Auth.ForgotPasswordRequestViewModel
@{
    ViewData["Title"] = "Forgot Password";
}

<div class="auth-wrapper">
    <div class="auth-card">
        <div class="text-center mb-4">
            <h3 class="fw-bold text-dark mb-1">Reset Password</h3>
            <p class="text-muted small">Enter your email and we'll send you a reset link</p>
        </div>

        <form asp-action="ForgotPassword" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label small fw-semibold">Email Address</label>
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0"><i class="bi bi-envelope text-muted"></i></span>
                    <input asp-for="Email" class="form-control border-start-0" placeholder="name@company.com" autocomplete="email" />
                </div>
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-gradient w-100 mb-3 shadow-sm">
                Send Reset Link <i class="bi bi-send ms-1"></i>
            </button>
        </form>

        <p class="text-center text-muted small mb-0">
            Remembered password? <a asp-action="Login" class="text-primary fw-semibold text-decoration-none">Log in</a>
        </p>
    </div>
</div>
