@model TaskPlatform.Shared.ViewModels.Auth.VerifyMfaRequestViewModel
@{
    ViewData["Title"] = "Two-Factor Authentication";
}

<div class="auth-wrapper">
    <div class="auth-card">
        <div class="text-center mb-4">
            <div class="text-primary mb-2">
                <i class="bi bi-shield-lock-fill" style="font-size: 3rem;"></i>
            </div>
            <h3 class="fw-bold text-dark mb-1">MFA Verification</h3>
            <p class="text-muted small">Enter the 6-digit code from your authenticator app</p>
        </div>

        <form asp-action="VerifyMfa" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="MfaChallengeToken" />

            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

            <div class="mb-4">
                <label asp-for="Code" class="form-label small fw-semibold">Verification Code</label>
                <input asp-for="Code" class="form-control text-center fs-4 tracking-wider fw-bold border-primary" placeholder="000000" maxlength="6" autocomplete="off" autofocus />
                <span asp-validation-for="Code" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-gradient w-100 mb-3 shadow-sm">
                Verify Code <i class="bi bi-check-lg ms-1"></i>
            </button>
        </form>
    </div>
</div>
