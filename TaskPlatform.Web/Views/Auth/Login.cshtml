@model TaskPlatform.Shared.ViewModels.Auth.LoginRequestViewModel
@{
    ViewData["Title"] = "Log In";
}

<div class="auth-wrapper">
    <div class="auth-card">
        <div class="text-center mb-4">
            <h3 class="fw-bold text-dark mb-1">Welcome Back</h3>
            <p class="text-muted small">Log in to manage your workspaces and projects</p>
        </div>

        <form asp-action="Login" method="post" asp-route-returnUrl="@ViewData["ReturnUrl"]">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label small fw-semibold">Email Address</label>
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0"><i class="bi bi-envelope text-muted"></i></span>
                    <input asp-for="Email" class="form-control border-start-0" placeholder="name@company.com" autocomplete="email" />
                </div>
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <label asp-for="Password" class="form-label small fw-semibold mb-0">Password</label>
                    <a asp-action="ForgotPassword" class="small text-decoration-none text-primary fw-medium">Forgot password?</a>
                </div>
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0"><i class="bi bi-lock text-muted"></i></span>
                    <input asp-for="Password" type="password" class="form-control border-start-0" placeholder="••••••••" autocomplete="current-password" />
                </div>
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-gradient w-100 mb-3 shadow-sm">
                Log In <i class="bi bi-arrow-right ms-1"></i>
            </button>
        </form>

        <div class="position-relative my-4 text-center">
            <hr class="text-muted opacity-25" />
            <span class="position-absolute top-50 start-50 translate-middle bg-white px-3 text-muted extra-small" style="font-size: 0.75rem;">OR CONTINUE WITH</span>
        </div>

        <button type="button" onclick="simulateGoogleLogin()" class="btn btn-outline-secondary w-100 rounded-3 d-flex align-items-center justify-content-center gap-2 mb-4 py-2 border-secondary-subtle">
            <svg width="18" height="18" viewBox="0 0 18 18"><path fill="#4285F4" d="M17.64 9.2c0-.637-.057-1.251-.164-1.84H9v3.481h4.844c-.209 1.125-.843 2.078-1.796 2.717v2.258h2.908c1.702-1.567 2.684-3.874 2.684-6.616z"/><path fill="#34A853" d="M9 18c2.43 0 4.467-.806 5.956-2.18l-2.908-2.259c-.806.54-1.837.86-3.048.86-2.344 0-4.328-1.584-5.036-3.711H.957v2.332A8.997 8.997 0 0 0 9 18z"/><path fill="#FBBC05" d="M3.964 10.71A5.41 5.41 0 0 1 3.682 9c0-.593.102-1.17.282-1.71V4.958H.957A8.996 8.996 0 0 0 0 9c0 1.452.348 2.827.957 4.042l3.007-2.332z"/><path fill="#EA4335" d="M9 3.58c1.321 0 2.508.454 3.44 1.345l2.582-2.58C13.463.891 11.426 0 9 0A8.997 8.997 0 0 0 .957 4.958L3.964 7.29C4.672 5.163 6.656 3.58 9 3.58z"/></svg>
            <span class="small fw-semibold text-dark">Sign in with Google</span>
        </button>

        <p class="text-center text-muted small mb-0">
            Don't have an account? <a asp-action="Register" class="text-primary fw-semibold text-decoration-none">Sign up</a>
        </p>
    </div>
</div>

<script>
    function simulateGoogleLogin() {
        const email = prompt("Enter Google Account Email for Dev Testing:", "devuser@gmail.com");
        if (!email) return;

        fetch('/api/v1/Auth/GoogleLogin', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ idToken: 'dev_google_token_' + email.split('@@')[0] })
        })
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                alert('Google authentication successful! Refreshing page...');
                window.location.href = '/';
            } else {
                alert('Google login failed: ' + data.message);
            }
        });
    }
</script>
