@model List<TaskPlatform.Shared.ViewModels.Notification.NotificationItemViewModel>
@{
    ViewData["Title"] = "Notifications";
    var unreadCount = Model.Count(n => !n.IsRead);
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h3 class="fw-bold mb-1"><i class="bi bi-bell text-primary me-2"></i>Notifications</h3>
                    <p class="text-muted small mb-0">@(unreadCount > 0 ? $"{unreadCount} unread" : "You're all caught up")</p>
                </div>
                @if (unreadCount > 0)
                {
                    <button type="button" id="markAllReadBtn" class="btn btn-outline-primary rounded-pill px-3">
                        <i class="bi bi-check2-all me-1"></i> Mark All as Read
                    </button>
                }
            </div>

            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-0">
                    @if (!Model.Any())
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-bell-slash text-muted display-4"></i>
                            <p class="text-muted mt-3 mb-0">No notifications yet.</p>
                        </div>
                    }
                    else
                    {
                        <ul class="list-group list-group-flush" id="notificationList">
                            @foreach (var n in Model)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-start py-3 notification-item @(n.IsRead ? "" : "bg-primary-subtle bg-opacity-10")" data-id="@n.Id">
                                    <div class="flex-grow-1">
                                        <div class="d-flex align-items-center gap-2">
                                            @if (!n.IsRead)
                                            {
                                                <span class="badge bg-primary rounded-circle p-1" style="width:8px;height:8px;"></span>
                                            }
                                            <span class="fw-semibold text-dark">@n.Title</span>
                                        </div>
                                        <p class="text-secondary mb-1 mt-1">@n.Message</p>
                                        <span class="extra-small text-muted">@n.CreatedAt.ToString("MMM dd, yyyy HH:mm")</span>
                                        @if (!string.IsNullOrEmpty(n.LinkUrl))
                                        {
                                            <a href="@n.LinkUrl" class="extra-small ms-2">View <i class="bi bi-arrow-right"></i></a>
                                        }
                                    </div>
                                    @if (!n.IsRead)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3 mark-read-btn" data-id="@n.Id">Mark as Read</button>
                                    }
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var csrfToken = document.querySelector('meta[name="request-verification-token"]')?.getAttribute('content') || '';

            function postJson(url) {
                return fetch(url, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-CSRF-TOKEN': csrfToken
                    },
                    body: JSON.stringify({})
                }).then(function (res) { return res.json(); });
            }

            document.getElementById('notificationList')?.addEventListener('click', function (e) {
                var btn = e.target.closest('.mark-read-btn');
                if (!btn) return;
                var id = btn.getAttribute('data-id');
                postJson('/Notifications/MarkAsRead/' + id).then(function () {
                    location.reload();
                });
            });

            document.getElementById('markAllReadBtn')?.addEventListener('click', function () {
                postJson('/Notifications/MarkAllAsRead').then(function () {
                    location.reload();
                });
            });
        })();
    </script>
}
