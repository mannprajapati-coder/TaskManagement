@model List<TaskPlatform.Shared.ViewModels.Notification.NotificationItemViewModel>
@{
    ViewData["Title"] = "Notifications";
    var unreadCount = Model.Count(n => !n.IsRead);
}

<div class="py-2">
    <!-- Header Banner -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-3 border-bottom">
        <div>
            <h3 class="fw-extrabold text-dark mb-1">
                <i class="bi bi-bell-fill text-primary me-2"></i>Notifications Inbox
            </h3>
            <p class="text-secondary small mb-0">
                @(unreadCount > 0 ? $"You have {unreadCount} unread notification(s)." : "You are completely caught up with all notifications.")
            </p>
        </div>

        <div>
            @if (unreadCount > 0)
            {
                <button type="button" id="markAllReadBtn" class="btn btn-outline-custom btn-sm px-3 shadow-sm">
                    <i class="bi bi-check2-all me-1 text-primary"></i> Mark All as Read
                </button>
            }
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white max-w-4xl mx-auto" style="max-width: 900px;">
        <div class="card-body p-0">
            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <div class="avatar bg-primary-subtle text-primary mx-auto mb-3" style="width: 64px; height: 64px; font-size: 2rem;">
                        <i class="bi bi-bell-slash"></i>
                    </div>
                    <h5 class="fw-bold text-dark">No Notifications</h5>
                    <p class="text-secondary small mb-0">Activity updates and task assignments will appear here.</p>
                </div>
            }
            else
            {
                <div class="list-group list-group-flush" id="notificationList">
                    @foreach (var n in Model)
                    {
                        <div class="list-group-item d-flex justify-content-between align-items-start p-4 notification-item @(n.IsRead ? "" : "bg-primary-subtle bg-opacity-10 border-start border-4 border-primary")" data-id="@n.Id">
                            <div class="d-flex gap-3 align-items-start">
                                <div class="avatar avatar-sm @(n.IsRead ? "bg-light text-secondary" : "bg-primary text-white")">
                                    <i class="bi bi-bell"></i>
                                </div>
                                <div>
                                    <div class="d-flex align-items-center gap-2">
                                        <h6 class="fw-bold text-dark mb-0">@n.Title</h6>
                                        @if (!n.IsRead)
                                        {
                                            <span class="badge bg-danger rounded-pill extra-small">NEW</span>
                                        }
                                    </div>
                                    <p class="text-secondary small mb-1 mt-1">@n.Message</p>
                                    <div class="d-flex align-items-center gap-3 extra-small text-muted">
                                        <span><i class="bi bi-clock me-1"></i>@n.CreatedAt.ToString("MMM dd, yyyy HH:mm")</span>
                                        @if (!string.IsNullOrEmpty(n.LinkUrl))
                                        {
                                            <a href="@n.LinkUrl" class="fw-semibold text-primary text-decoration-none">Open Details <i class="bi bi-arrow-right"></i></a>
                                        }
                                    </div>
                                </div>
                            </div>
                            
                            @if (!n.IsRead)
                            {
                                <button type="button" class="btn btn-sm btn-light text-muted rounded-pill px-3 mark-read-btn" data-id="@n.Id">
                                    Mark Read
                                </button>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var csrfToken = document.querySelector('meta[name="request-verification-token"]')?.getAttribute('content') || '';

            function postJson(url) {
                return fetch(url, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-CSRF-TOKEN': csrfToken
                    },
                    body: JSON.stringify({})
                }).then(function (res) { return res.json(); });
            }

            document.getElementById('notificationList')?.addEventListener('click', function (e) {
                var btn = e.target.closest('.mark-read-btn');
                if (!btn) return;
                var id = btn.getAttribute('data-id');
                postJson('/Notifications/MarkAsRead/' + id).then(function () {
                    location.reload();
                });
            });

            document.getElementById('markAllReadBtn')?.addEventListener('click', function () {
                postJson('/Notifications/MarkAllAsRead').then(function () {
                    location.reload();
                });
            });
        })();
    </script>
}
