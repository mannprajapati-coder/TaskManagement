## A streamlined .gitignore for modern .NET projects
## including temporary files, build results, and
## files generated by popular .NET tools.

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Bb]inaries/
[Oo]bj/
[Ll]og/
[Ll]ogs/
out/
build/

# Visual Studio & IDE files
.vs/
.vscode/
.idea/
*.user
*.userosv
*.suo
*.userprefs
*.sln.docstates
*.DotSettings.user
*.slnLaunch.user

# .NET Core & Artifacts
project.lock.json
project.fragment.lock.json
artifacts/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# NuGet Packages
*.nupkg
*.snupkg

# dotenv & Local Environment Files
.env
.env.local
.env.*.local
appsettings.*.local.json

# Test Results & Code Coverage
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
CodeCoverage/
*.coverage
*.coveragexml

# NUnit
*.VisualState.xml
TestResult.xml
nunit-*.xml

# MSBuild Binary and Structured Log
*.binlog

# OS Generated Files
.DS_Store
Thumbs.db
desktop.ini

# Temporary files
~$*
*~
*.tmp
*.bak
*.swp
